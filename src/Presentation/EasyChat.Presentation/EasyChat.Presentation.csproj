<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>EasyChat.Presentation</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EasyChat.Presentation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Material.Icons" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="ReactiveUI" Version="22.3.1" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\EasyChat.Contracts\EasyChat.Contracts.csproj" />
    <ProjectReference Include="..\EasyChat.Presentation.Shared\EasyChat.Presentation.Shared.csproj" />
  </ItemGroup>
  <!-- Theme dictionaries have no x:Class; keep them as AvaloniaResource for avares:// includes. -->
  <ItemGroup>
    <AvaloniaResource Include="Themes\**\*.axaml" />
    <AvaloniaXaml Remove="Themes\**\*.axaml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Lang\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <LogicalName>EasyChat.Presentation.Lang.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Lang\Resources.zh.resx">
      <LogicalName>EasyChat.Presentation.Lang.Resources.zh.resources</LogicalName>
    </EmbeddedResource>
    <Compile Update="Lang\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
