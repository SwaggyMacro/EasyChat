<UserControl x:Class="EasyChat.Presentation.Features.Shortcuts.Views.ShortcutEditDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:dialogs="clr-namespace:EasyChat.Presentation.Features.Shortcuts"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:DataType="dialogs:ShortcutEditDialogViewModel"
             MinWidth="400"
             MaxWidth="440"
             Width="420">
    <UserControl.Styles>
        <Style Selector="Border.HotkeyCaptureArea">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.HotkeyCaptureArea.Recording">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.HotkeyCaptureArea">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.HotkeyCaptureArea.Recording">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor10}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <avalonia:MaterialIcon Kind="{Binding Icon}"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="Large" TextWrapping="Wrap" Text="{Binding DialogTitle}" />
                    <TextBlock Text="{Binding SelectedAction.DisplayName}"
                               Classes="Muted"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
        <!-- Action Type Selection -->
        <StackPanel>
            <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.ActionType}" />
            <ComboBox ItemsSource="{Binding AvailableActions}"
                      SelectedItem="{Binding SelectedAction}"
                      Classes="Outline"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:ShortcutActionOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel>
            <TextBlock Classes="Small" Margin="0,0,0,6" Text="{x:Static lang:Resources.ShortcutRemark}" />
            <TextBox Text="{Binding Remark, Mode=TwoWay}"
                     MaxLength="100"
                     shad:ControlAssist.Label="{x:Static lang:Resources.ShortcutRemarkPlaceholder}" />
        </StackPanel>

        <!-- Parameter Input (Standard) -->
        <StackPanel Spacing="12" IsVisible="{Binding SelectedAction.RequiresParameter}">

            <!-- Standard Parameter UI -->
            <StackPanel Spacing="10" IsVisible="{Binding !IsComplexSwitchAction}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="Small"
                               Text="{x:Static lang:Resources.Parameter}" Margin="0" />
                    <TextBlock Text="{Binding SelectedAction.ParameterHint, StringFormat='({0})'}"
                               Classes="Muted"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Helper Text if Options Available -->
                <ComboBox ItemsSource="{Binding AvailableParameterOptions}"
                          SelectedItem="{Binding Parameter}"
                          IsVisible="{Binding AvailableParameterOptions, Converter={x:Static ObjectConverters.IsNotNull}}"
                          HorizontalAlignment="Stretch" />

                <TextBox Text="{Binding Parameter}"
                         shad:ControlAssist.Label="{Binding SelectedAction.ParameterHint}"
                         IsVisible="{Binding AvailableParameterOptions, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>

            <!-- Complex Parameter UI (Engine, Source, Target) -->
            <StackPanel Spacing="10" IsVisible="{Binding IsComplexSwitchAction}">
                <!-- Engine -->
                <StackPanel>
                    <TextBlock Text="{x:Static lang:Resources.TransEngine}" Classes="Small" Margin="0 0 0 5"/>
                    <ComboBox ItemsSource="{Binding AvailableEngineOptions}"
                              SelectedItem="{Binding SelectedEngineOption}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="20" Height="20">
                                        <Border ClipToBounds="True" CornerRadius="4"
                                                IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasIcon}}">
                                            <Image Source="{Binding Name, Converter={x:Static converts:EngineConverters.ToIcon}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <avalonia:MaterialIcon Kind="Robot" Width="20" Height="20"
                                                               Foreground="{DynamicResource ForegroundColor}"
                                                               IsVisible="{Binding Name, Converter={x:Static converts:EngineConverters.HasNoIcon}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*, 10, *">
                    <!-- Source -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static lang:Resources.Action_SwitchSourceLang}" Classes="Small" Margin="0 0 0 5"/>
                        <controls:LanguageSelector Languages="{Binding AvailableLanguages}"
                                                   SelectedLanguage="{Binding SelectedSourceLang, Mode=TwoWay}"
                                                   HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Target -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static lang:Resources.Action_SwitchTargetLang}" Classes="Small" Margin="0 0 0 5"/>
                        <controls:LanguageSelector Languages="{Binding AvailableLanguages}"
                                                   SelectedLanguage="{Binding SelectedTargetLang, Mode=TwoWay}"
                                                   HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsAutomaticAction}">
            <TextBlock Classes="Small" Text="{x:Static lang:Resources.AutomaticShortcutTrigger}" />
            <ComboBox ItemsSource="{Binding AutomaticTriggers}" SelectedItem="{Binding SelectedAutomaticTriggerOption}" />
            <TextBlock Classes="Small" Text="{x:Static lang:Resources.AutomaticShortcutPressMode}" />
            <ComboBox ItemsSource="{Binding AutomaticPressModes}" SelectedItem="{Binding SelectedAutomaticPressModeOption}" />
        </StackPanel>

        <CheckBox Content="{x:Static lang:Resources.ReadSelectedText}"
                  IsChecked="{Binding ReadSelectedText}"
                  IsEnabled="{Binding !IsReadSelectionLocked}"
                  IsVisible="{Binding IsTextAssistAction}" />

        <StackPanel Spacing="4" IsVisible="{Binding IsModeSelectableTextAssistAction}">
            <TextBlock Text="Mode" Classes="Small" />
            <ComboBox ItemsSource="{Binding TextAssistModes}" SelectedItem="{Binding TextAssistMode}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsSelectionTranslateAction}">
            <CheckBox Content="{Binding SelectionToolbarOptionText}"
                      IsChecked="{Binding ShowSelectionToolbar}" VerticalAlignment="Center" />
            <Border Width="28" Height="28" CornerRadius="4" Cursor="Help" Background="Transparent"
                    VerticalAlignment="Center" ToolTip.ShowDelay="0"
                    ToolTip.Placement="Right" ToolTip.Tip="{Binding SelectionToolbarOptionTip}"
                    PointerEntered="OnSelectionToolbarInfoPointerEntered"
                    PointerExited="OnSelectionToolbarInfoPointerExited">
                <avalonia:MaterialIcon Kind="InformationOutline" Width="19" Height="19"
                                       Opacity="0.72" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsInputTranslateAction}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox Content="{x:Static lang:Resources.ReplaceCurrentInput}"
                          IsChecked="{Binding ReplaceCurrentInput}" />
                <Border Background="Transparent"
                        Padding="2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static lang:Resources.ReplaceCurrentInputTip}">
                    <avalonia:MaterialIcon Kind="InformationOutline"
                                           Width="16"
                                           Height="16"
                                           Opacity="0.65"
                                           IsHitTestVisible="False" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Static lang:Resources.InputTranslateSimulatedKeys}"
                           Classes="Small"
                           VerticalAlignment="Center" />
                <Border Background="Transparent"
                        Padding="2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{x:Static lang:Resources.InputTranslateSimulatedKeysTip}">
                    <avalonia:MaterialIcon Kind="InformationOutline"
                                           Width="16"
                                           Height="16"
                                           Opacity="0.65"
                                           IsHitTestVisible="False" />
                </Border>
            </StackPanel>

            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{x:Static lang:Resources.BeforeTextInput}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="HotkeyCaptureArea"
                        Classes.Recording="{Binding IsRecordingBeforeInputKey}"
                        Command="{Binding ToggleBeforeInputKeyRecordingCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{x:Static lang:Resources.RecordShortcut}">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedBeforeInputKey}"
                                                     IsVisible="{Binding DisplayedBeforeInputKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="0"
                                   Text="{x:Static lang:Resources.RecordingShortcut}"
                                   IsVisible="{Binding IsBeforeInputRecordingPromptVisible}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   HorizontalAlignment="Center" />
                        <avalonia:MaterialIcon Grid.Column="1" Kind="Keyboard" Opacity="0.5" />
                    </Grid>
                </Button>
                <Button Grid.Column="2"
                        Classes="Destructive"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        MinHeight="28"
                        Padding="0"
                        CornerRadius="14"
                        Command="{Binding ClearBeforeInputKeyCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                    <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{x:Static lang:Resources.AfterTextInput}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="HotkeyCaptureArea"
                        Classes.Recording="{Binding IsRecordingAfterInputKey}"
                        Command="{Binding ToggleAfterInputKeyRecordingCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{x:Static lang:Resources.RecordShortcut}">
                    <Grid ColumnDefinitions="*,Auto">
                        <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedAfterInputKey}"
                                                     IsVisible="{Binding DisplayedAfterInputKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="0"
                                   Text="{x:Static lang:Resources.RecordingShortcut}"
                                   IsVisible="{Binding IsAfterInputRecordingPromptVisible}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   HorizontalAlignment="Center" />
                        <avalonia:MaterialIcon Grid.Column="1" Kind="Keyboard" Opacity="0.5" />
                    </Grid>
                </Button>
                <Button Grid.Column="2"
                        Classes="Destructive"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        MinHeight="28"
                        Padding="0"
                        CornerRadius="14"
                        Command="{Binding ClearAfterInputKeyCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.Delete}">
                    <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Hotkey Recording: focusable Border (not Button) so keys are not eaten by button chrome. -->
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding KeyCombinationLabel}" Classes="Small" />
            <Border x:Name="HotkeyCapturePad"
                    Classes="HotkeyCaptureArea"
                    Classes.Recording="{Binding IsRecording}"
                    Focusable="True"
                    IsTabStop="True"
                    Cursor="Hand"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Padding="16,14"
                    MinHeight="56"
                    HorizontalAlignment="Stretch"
                    PointerPressed="OnCapturePadPointerPressed"
                    KeyDown="OnCapturePadKeyDown">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel VerticalAlignment="Center">
                        <controls:KeySequenceDisplay KeyCombination="{Binding DisplayedKeyCombination}"
                                                     IsVisible="{Binding DisplayedKeyCombination, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static lang:Resources.RecordingShortcut}"
                                   IsVisible="{Binding DisplayedKeyCombination, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                   Foreground="{DynamicResource PrimaryColor}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <avalonia:MaterialIcon Grid.Column="1"
                                           Kind="Keyboard"
                                           Width="20" Height="20"
                                           Opacity="0.45"
                                           VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="{x:Static lang:Resources.ClickToRecord}"
                       IsVisible="{Binding IsNotRecording}"
                       Classes="Muted"
                       HorizontalAlignment="Center" />
        </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="DialogFooter" Margin="0,12,0,0" Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="Ghost"
                        MinWidth="88"
                        Command="{Binding CancelCommand}" />
                <Button Content="{Binding ButtonText}"
                        Command="{Binding SaveCommand}"
                        Classes="Primary"
                        MinWidth="96" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
