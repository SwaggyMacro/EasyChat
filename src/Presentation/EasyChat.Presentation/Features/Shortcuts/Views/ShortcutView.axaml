<UserControl x:Class="EasyChat.Presentation.Features.Shortcuts.Views.ShortcutView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shortcuts"
             xmlns:settingsState="clr-namespace:EasyChat.Presentation.Features.Settings.State"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:DataType="viewModels:ShortcutViewModel"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource GhostColor}">

    <UserControl.Styles>
        <Style Selector="Button.ShortcutEntry">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.12"
                                                   Easing="CircularEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ShortcutEntry:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>
        <Style Selector="Button.ShortcutEntry:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.80" />
            <Setter Property="RenderTransform" Value="scale(0.985)" />
        </Style>
        <Style Selector="Button.ShortcutDelete">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="Button.ShortcutDelete:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
        </Style>
        <Style Selector="Button.ShortcutDelete:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="shad|Card.ShortcutCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasShadow" Value="True" />
        </Style>
        <Style Selector="shad|Card.ShortcutCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="HasShadow" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Margin="32,28,32,28"
          MaxWidth="1120"
          HorizontalAlignment="Stretch">

        <shad:Card Grid.Row="0"
                   Padding="22,20"
                   HasShadow="False">
            <Grid RowDefinitions="Auto,Auto">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static lang:Resources.Shortcut}"
                                   Classes="h2"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="{x:Static lang:Resources.Shortcut}" />
                        <shad:Badge Content="{Binding ActiveShortcutCount}"
                                    IsVisible="{Binding HasActiveShortcuts}"
                                    VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Classes="Primary"
                            Command="{Binding AddEntryCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                            <TextBlock Text="{Binding AddButtonLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{x:Static lang:Resources.HomeQuickShortcutHint}"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedColor}"
                               TextWrapping="Wrap"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               Margin="0,5,0,0" />
                </Grid>

                <TabControl Grid.Row="1"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0"
                            SelectedIndex="{Binding CategoryTabIndex}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Keyboard" Width="16" Height="16"
                                                       Foreground="{DynamicResource PrimaryColor}" />
                                <TextBlock Text="{x:Static lang:Resources.BasicShortcuts}" FontWeight="SemiBold" />
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                       Foreground="{DynamicResource PrimaryColor}" />
                                <TextBlock Text="{x:Static lang:Resources.LanguageShortcuts}" FontWeight="SemiBold" />
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <avalonia:MaterialIcon Kind="AutoFix" Width="16" Height="16"
                                                       Foreground="{DynamicResource PrimaryColor}" />
                                <TextBlock Text="{x:Static lang:Resources.AutomaticShortcuts}" FontWeight="SemiBold" />
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                </TabControl>
            </Grid>
        </shad:Card>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <shad:Card IsVisible="{Binding HasNoActiveShortcuts}"
                       Padding="30,34"
                       HasShadow="True"
                       VerticalAlignment="Top">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                    <Border Width="58" Height="58" CornerRadius="16"
                            Background="{DynamicResource GhostColor}">
                        <avalonia:MaterialIcon Kind="Keyboard"
                                               Width="28" Height="28"
                                               Foreground="{DynamicResource PrimaryColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Classes="Muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Classes="Primary"
                            HorizontalAlignment="Center"
                            Command="{Binding AddEntryCommand}"
                            Content="{Binding AddButtonLabel}" />
                </StackPanel>
            </shad:Card>

            <ScrollViewer IsVisible="{Binding HasActiveShortcuts}"
                          Margin="0,0,-15,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ActiveShortcuts}"
                              Margin="0,0,15,0"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settingsState:ShortcutEntryState">
                            <shad:Card Classes="ShortcutCard"
                                       Padding="0"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="1"
                                            Width="130"
                                            IsHitTestVisible="False"
                                            Opacity="0" />

                                    <Button Classes="ShortcutEntry"
                                            Grid.ColumnSpan="4"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).EditEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Edit}"
                                            Cursor="Hand"
                                            Padding="16,14">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border Width="38" Height="38" CornerRadius="11"
                                                        Background="{DynamicResource GhostColor}"
                                                        VerticalAlignment="Top">
                                                    <avalonia:MaterialIcon Kind="Keyboard"
                                                                           Width="19" Height="19"
                                                                           Foreground="{DynamicResource PrimaryColor}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   Classes="Large"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundColor}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ActionDisplayText}"
                                                                   IsVisible="{Binding HasRemark}"
                                                                   Classes="Muted"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ParameterDisplayText}"
                                                               IsVisible="{Binding ParameterDisplayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="42"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedColor}" />
                                                </StackPanel>
                                            </Grid>
                                            <controls:KeySequenceDisplay Grid.Column="1"
                                                                         KeyCombination="{Binding KeyCombination}"
                                                                         MinWidth="130"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Width="48" />
                                            <Border Grid.Column="3" Width="34" />
                                        </Grid>
                                    </Button>

                                    <ToggleSwitch Grid.Column="2"
                                                  IsChecked="{Binding IsEnabled}"
                                                  ZIndex="1"
                                                  VerticalAlignment="Center" />

                                    <Button Grid.Column="3"
                                            Classes="Icon ShortcutDelete"
                                            ZIndex="1"
                                            Command="{Binding $parent[ItemsControl].((viewModels:ShortcutViewModel)DataContext).RemoveEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Delete}"
                                            MinWidth="34"
                                            MinHeight="34"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="TrashCan"
                                                               Width="16" Height="16"
                                                               Foreground="{DynamicResource DestructiveColor}" />
                                    </Button>
                                </Grid>
                            </shad:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
