<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EasyChat.Presentation.Features.Capture.Views.OverlayWindowView"
        Closed="TopLevel_OnClosed" KeyDown="InputElement_OnKeyDown"
        Title="OverlayWindow">
    <Grid Background="Black">
        <Image x:Name="CapturedScreenImage"
               Stretch="Fill"
               IsHitTestVisible="False" />
        <Canvas Name="MainCanvas">
        <!-- Main Selection Box -->
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="{DynamicResource EcAccent}"
                   StrokeThickness="2"
                   Fill="{DynamicResource EcAccentSoft}"
                   IsVisible="False" />
        
        <!-- Resize Handles (EcHandleFill stays high-contrast on any screenshot) -->
        <Border x:Name="HandleTopLeft" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="TopLeftCorner" />
        <Border x:Name="HandleTopCenter" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="SizeNorthSouth" />
        <Border x:Name="HandleTopRight" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="TopRightCorner" />
        <Border x:Name="HandleRightCenter" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="SizeWestEast" />
        <Border x:Name="HandleBottomRight" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="BottomRightCorner" />
        <Border x:Name="HandleBottomCenter" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="SizeNorthSouth" />
        <Border x:Name="HandleBottomLeft" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="BottomLeftCorner" />
        <Border x:Name="HandleLeftCenter" Width="14" Height="14" Background="{DynamicResource EcHandleFill}" BorderBrush="{DynamicResource EcAccent}" BorderThickness="1" CornerRadius="7" IsVisible="False" Cursor="SizeWestEast" />

        <Border x:Name="HintBorder"
                Classes="EcFloatShell"
                Background="{DynamicResource EcFloatBg}"
                Padding="16,12"
                CornerRadius="10"
                IsVisible="False">
            <TextBlock x:Name="HintTextBlock"
                       Foreground="{DynamicResource EcTextPrimary}"
                       FontSize="15" />
        </Border>

        <Border x:Name="ToolbarBorder"
                CornerRadius="12"
                Padding="2"
                IsVisible="False"
                Background="{DynamicResource EcFloatBg}"
                BorderBrush="{DynamicResource EcFloatBorder}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <Button x:Name="ConfirmButton"
                        Classes="EcToolbarBtn"
                        Width="44" Height="40"
                        Padding="10,8"
                        CornerRadius="10,0,0,10"
                        Click="ConfirmButton_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Confirm}">
                     <icon:MaterialIcon Kind="Check" Width="22" Height="22" Foreground="{DynamicResource EcSuccess}" />
                </Button>
                <Button x:Name="CopyButton"
                        Classes="EcToolbarBtn"
                        Width="44" Height="40"
                        Padding="10,8"
                        CornerRadius="0"
                        PointerEntered="CopyButton_OnPointerEntered"
                        PointerExited="CopyButton_OnPointerExited"
                        ToolTip.Tip="{x:Static lang:Resources.Copy}">
                    <icon:MaterialIcon Kind="ContentCopy" Width="22" Height="22" Foreground="{DynamicResource EcAccent}" />
                </Button>
                <Button x:Name="ResetButton"
                        Classes="EcToolbarBtn"
                        Width="44" Height="40"
                        Padding="10,8"
                        CornerRadius="0"
                        Click="ResetButton_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Reset}">
                    <icon:MaterialIcon Kind="Refresh" Width="22" Height="22" Foreground="{DynamicResource EcTextSecondary}" />
                </Button>
                <Button x:Name="CancelButton"
                        Classes="EcToolbarBtn"
                        Width="44" Height="40"
                        Padding="10,8"
                        CornerRadius="0,10,10,0"
                        Click="CancelButton_OnClick"
                        ToolTip.Tip="{x:Static lang:Resources.Cancel}">
                    <icon:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource EcDanger}" />
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="CopyMenuBorder"
                IsVisible="False"
                Background="{DynamicResource EcFloatBg}"
                BorderBrush="{DynamicResource EcFloatBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                PointerEntered="CopyMenu_OnPointerEntered"
                PointerExited="CopyMenu_OnPointerExited">
            <StackPanel Spacing="2">
                <StackPanel.Styles>
                    <Style Selector="Button.EcMenuItem">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                    <Style Selector="icon|MaterialIcon">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="Foreground" Value="{DynamicResource EcTextSecondary}" />
                    </Style>
                </StackPanel.Styles>

                <Button Classes="EcMenuItem" Click="CopyOriginal_OnClick">
                   <StackPanel Orientation="Horizontal" Spacing="10">
                       <icon:MaterialIcon Kind="ContentCopy" />
                       <TextBlock Text="{x:Static lang:Resources.CopyOriginal}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource EcTextPrimary}" />
                   </StackPanel>
                </Button>
                <Button Classes="EcMenuItem" Click="CopyTranslated_OnClick">
                   <StackPanel Orientation="Horizontal" Spacing="10">
                       <icon:MaterialIcon Kind="Translate" />
                       <TextBlock Text="{x:Static lang:Resources.CopyTranslated}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource EcTextPrimary}" />
                   </StackPanel>
                </Button>
                <Button Classes="EcMenuItem" Click="CopyBilingual_OnClick">
                   <StackPanel Orientation="Horizontal" Spacing="10">
                       <icon:MaterialIcon Kind="ViewAgenda" />
                       <TextBlock Text="{x:Static lang:Resources.CopyBilingual}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource EcTextPrimary}" />
                   </StackPanel>
                </Button>
                <Button Classes="EcMenuItem" Click="CopyImageTranslated_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icon:MaterialIcon Kind="ImageEdit" />
                        <TextBlock Text="{x:Static lang:Resources.ImageTranslate}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource EcTextPrimary}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        </Canvas>
    </Grid>
</Window>
