<UserControl x:Class="EasyChat.Presentation.Features.Capture.Views.FixedAreaFormDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Capture"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:DataType="viewModels:FixedAreaFormDialogViewModel"
             MinWidth="360"
             MaxWidth="420"
             Width="400">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EcDialogHeader">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource EcAccentSoft}">
                    <avalonia:MaterialIcon Kind="Crop"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EcAccent}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="EcDialogTitle"
                           Text="{x:Static lang:Resources.Edit}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="EcDialogScroll">
            <StackPanel Classes="EcDialogBody">
                <StackPanel>
                    <TextBlock Classes="EcFieldLabel" Text="{x:Static lang:Resources.Name}" />
                    <TextBox Text="{Binding Name}" suki:TextBoxExtensions.AddDeleteButton="True" />
                </StackPanel>

                <Border Padding="14,12"
                        Background="{DynamicResource EcBgMuted}"
                        BorderBrush="{DynamicResource EcBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource EcRadiusMd}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="VectorSquare" Width="16" Height="16"
                                                   Foreground="{DynamicResource EcAccent}" />
                            <TextBlock Text="{x:Static lang:Resources.Area}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource EcTextPrimary}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{Binding DisplayInfo}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource EcTextSecondary}"
                                       FontFamily="{DynamicResource EcFontFamilyMono}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="EcGhost" Command="{Binding ReselectAreaCommand}"
                                    ToolTip.Tip="{x:Static lang:Resources.ReselectArea}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:MaterialIcon Kind="Crop" Width="16" Height="16" />
                                    <TextBlock Text="{x:Static lang:Resources.Select}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="EcDialogFooter">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="{x:Static lang:Resources.Cancel}"
                        Classes="EcGhost"
                        MinWidth="88"
                        Command="{Binding CancelCommand}" />
                <Button Content="{x:Static lang:Resources.Save}"
                        Command="{Binding ConfirmCommand}"
                        Classes="EcPrimary"
                        MinWidth="96" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
