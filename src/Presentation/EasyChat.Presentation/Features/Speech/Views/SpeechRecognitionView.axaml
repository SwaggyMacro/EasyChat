<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.SpeechRecognitionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Speech;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:DataType="vm:SpeechRecognitionViewModel" Background="{DynamicResource GhostColor}">

    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.AudioSourceFlyout">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBlock.SpeechConfigLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Control.SpeechConfigInput">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

    </UserControl.Styles>

    <Panel>
        <!-- Loading overlay - shown initially -->
        <Grid x:Name="LoadingOverlay" IsVisible="True">
            <Border Background="{DynamicResource GhostColor}" Opacity="0.92" />
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <shad:Loading Width="24" Height="24"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource PrimaryColor}" />
                <TextBlock Text="{x:Static lang:Resources.Loading}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedColor}" />
            </StackPanel>
        </Grid>

        <!-- Main Content - hidden initially -->
        <Grid x:Name="MainContent" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="32,28,32,28" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,8"
                  ColumnSpacing="16"
                  IsVisible="{Binding IsSupported}">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Static lang:Resources.Page_LiveTranslate}"
                           Classes="h2"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{x:Static lang:Resources.Page_LiveTranslate}" />

                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding OpenAudioTranslationTutorialCommand}"
                            Classes="Outline"
                            IsVisible="{Binding IsLiveCaptionsMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
                            <TextBlock Text="{x:Static lang:Resources.Speech_UsageTutorial}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenInterpretationTutorialCommand}"
                            Classes="Outline"
                            IsVisible="{Binding IsVoiceTranslationMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
                            <TextBlock Text="{x:Static lang:Resources.Speech_UsageTutorial}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFloatingWindowCommand}"
                            Classes="Outline">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="PictureInPictureBottomRight" Width="18" Height="18" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding IsFloatingWindowOpen, Converter={x:Static converts:BoolToTextConverter.Instance}, ConverterParameter='FloatingWindow_Open|FloatingWindow_Close'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{x:Static lang:Resources.HomeQuickSpeechHint}"
                           Classes="Small"
                           LineHeight="20"
                           Foreground="{DynamicResource MutedColor}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           MaxWidth="720"
                           HorizontalAlignment="Left" />
            </Grid>

            <!-- Translation output mode -->
            <TabControl Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        IsVisible="{Binding IsSupported}"
                        SelectedIndex="{Binding SpeechModeTabIndex}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="ClosedCaption" Width="16" Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{x:Static lang:Resources.Speech_Mode_Recognition}" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                   Foreground="{DynamicResource PrimaryColor}" />
                            <TextBlock Text="{x:Static lang:Resources.Speech_Mode_Interpretation}" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" IsVisible="{Binding IsSupported}">
            <Grid RowDefinitions="Auto,*">
                        <!-- Live session toolbar -->
                        <shad:Card Grid.Row="0" Margin="0,0,0,10" HasShadow="True">
                            <Grid ColumnDefinitions="Auto,240,*,Auto,240"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{x:Static lang:Resources.Speech_RecognitionLanguage}"
                                           Classes="Small SpeechConfigLabel"
                                           Margin="0" />
                                <ec:LanguageSelector Grid.Row="0" Grid.Column="1"
                                                     Languages="{Binding RecognitionLanguages}"
                                                     SelectedLanguage="{Binding SelectedRecognitionModel, Mode=TwoWay}"
                                                     Classes="SpeechConfigInput" />

                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="{x:Static lang:Resources.TargetLang}"
                                           Classes="Small SpeechConfigLabel"
                                           IsVisible="{Binding IsTranslationEnabled}" />
                                <ec:LanguageSelector Grid.Row="0" Grid.Column="4"
                                                     Languages="{Binding TargetLanguages}"
                                                     SelectedLanguage="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                                     Classes="SpeechConfigInput"
                                                     IsVisible="{Binding IsTranslationEnabled}" />

                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{x:Static lang:Resources.TransEngine}"
                                           Classes="Small SpeechConfigLabel"
                                           Margin="0"
                                           IsVisible="{Binding IsTranslationEnabled}" />
                                <ComboBox Grid.Row="1" Grid.Column="4"
                                          ItemsSource="{Binding EngineOptions}"
                                          SelectedItem="{Binding SelectedEngineOption}"
                                          Classes="SpeechConfigInput"
                                          IsVisible="{Binding IsTranslationEnabled}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Panel Width="20" Height="20">
                                                        <avalonia:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                                               Foreground="{DynamicResource MutedColor}"
                                                                               IsVisible="{Binding IsGlobal}" />
                                                        <Panel IsVisible="{Binding !IsGlobal}">
                                                            <Panel IsVisible="{Binding !IsMachine}">
                                                                 <Image Width="20" Height="20"
                                                                        IsVisible="{Binding ImageValue, Converter={x:Static converts:AiModelTypeConverters.HasIcon}}"
                                                                        Source="{Binding ImageValue, Converter={x:Static converts:AiModelTypeConverters.ToIcon}}" />
                                                                 <avalonia:MaterialIcon Kind="Robot"
                                                                                        Width="20" Height="20"
                                                                                        Foreground="{DynamicResource MutedColor}"
                                                                                        IsVisible="{Binding ImageValue, Converter={x:Static converts:AiModelTypeConverters.HasNoIcon}}" />
                                                            </Panel>
                                                            <Panel IsVisible="{Binding IsMachine}">
                                                                <Border ClipToBounds="True" CornerRadius="4"
                                                                        IsVisible="{Binding ImageValue, Converter={x:Static converts:EngineConverters.HasIcon}}">
                                                                    <Image Source="{Binding ImageValue, Converter={x:Static converts:EngineConverters.ToIcon}}"
                                                                           Width="20" Height="20" Stretch="UniformToFill" />
                                                                </Border>
                                                                <avalonia:MaterialIcon Kind="Translate" Width="20" Height="20"
                                                                                       Foreground="{DynamicResource MutedColor}"
                                                                                       IsVisible="{Binding ImageValue, Converter={x:Static converts:EngineConverters.HasNoIcon}}" />
                                                            </Panel>
                                                        </Panel>
                                                    </Panel>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{x:Static lang:Resources.Speech_AudioSource}"
                                           Classes="Small SpeechConfigLabel"
                                           Margin="0" />
                                <Button Grid.Row="1" Grid.Column="1"
                                        Classes="Outline SpeechConfigInput"
                                        Padding="8,4"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom"
                                                    ShowMode="Standard"
                                                    FlyoutPresenterClasses="AudioSourceFlyout">
                                                <shad:Card MinWidth="280" MaxHeight="500" Background="{DynamicResource DialogBackgroundColor}" HasShadow="False">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                                                            <TextBlock Text="{x:Static lang:Resources.Speech_SelectSourceTitle}" Classes="Small"
                                                                       Margin="0"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding RefreshSourcesCommand}"
                                                                    Classes="Icon"
                                                                    ToolTip.Tip="{x:Static lang:Resources.Speech_Refresh}">
                                                                <avalonia:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                                            </Button>
                                                        </Grid>
                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                                            <ItemsControl ItemsSource="{Binding AudioSources}" Margin="0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  Margin="0,2"
                                                                                  Padding="6,4"
                                                                                  Background="Transparent"
                                                                                  CornerRadius="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <Image Source="{Binding AppIcon}"
                                                                                       Width="20" Height="20"
                                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                                       VerticalAlignment="Center" />
                                                                                <StackPanel Spacing="1">
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource ForegroundColor}"/>
                                                                                    <TextBlock Text="{Binding Category}"
                                                                                               IsVisible="{Binding HasCategory}"
                                                                                               Classes="Small"
                                                                                               Foreground="{DynamicResource MutedColor}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </shad:Card>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding SelectedSourcesSummary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ForegroundColor}"/>
                                            <avalonia:MaterialIcon Grid.Column="1"
                                                                   Kind="ChevronDown"
                                                                   Width="16" Height="16"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource MutedColor}"/>
                                        </Grid>
                                </Button>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{x:Static lang:Resources.Prompts}"
                                           Classes="Small SpeechConfigLabel"
                                           IsVisible="{Binding IsPromptSelectionVisible}" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding PromptOptions}"
                                          SelectedItem="{Binding SelectedPromptOption}"
                                          Classes="SpeechConfigInput"
                                           IsVisible="{Binding IsPromptSelectionVisible}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <avalonia:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" />
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundColor}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <WrapPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                           Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <CheckBox Content="{x:Static lang:Resources.Speech_EnableTranslation}"
                                              IsChecked="{Binding IsTranslationEnabled}"
                                              IsVisible="{Binding IsLiveCaptionsMode}"
                                              Margin="0,0,16,0" />
                                    <CheckBox Content="{x:Static lang:Resources.Speech_RealTimePreview}"
                                              IsChecked="{Binding IsRealTimePreviewEnabled}"
                                              IsVisible="{Binding IsRealTimePreviewVisible}"
                                              ToolTip.Tip="{x:Static lang:Resources.Speech_RealTimePreviewTip}" />
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{x:Static lang:Resources.Speech_TargetVirtualMicrophones}"
                                           Classes="Small SpeechConfigLabel"
                                           IsVisible="{Binding IsVoiceTranslationMode}"
                                           ToolTip.Tip="{x:Static lang:Resources.Speech_TranslatedSpeechTip}" />
                                <Button Grid.Row="3" Grid.Column="1"
                                            Classes="Outline SpeechConfigInput"
                                            Width="240"
                                            Padding="8,4"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            IsVisible="{Binding IsVoiceTranslationMode}">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom"
                                                    ShowMode="Standard"
                                                    FlyoutPresenterClasses="AudioSourceFlyout">
                                                <shad:Card MinWidth="320" MaxHeight="460"
                                                           Background="{DynamicResource DialogBackgroundColor}"
                                                           HasShadow="False">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <TextBlock Text="{x:Static lang:Resources.Speech_TargetVirtualMicrophones}"
                                                                   Classes="Small"
                                                                   Margin="12,10" />
                                                        <ScrollViewer Grid.Row="1"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="390">
                                                            <ItemsControl ItemsSource="{Binding VirtualMicrophoneOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  Margin="0,2"
                                                                                  Padding="6,4"
                                                                                  Background="Transparent"
                                                                                  CornerRadius="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <avalonia:MaterialIcon Kind="VolumeOff"
                                                                                                       Width="18" Height="18"
                                                                                                       IsVisible="{Binding IsNoOperation}"
                                                                                                       Foreground="{DynamicResource MutedColor}" />
                                                                                <StackPanel Spacing="1">
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                                                    <TextBlock Text="{Binding Description}"
                                                                                               Classes="Small"
                                                                                               IsVisible="{Binding HasDescription}"
                                                                                               Foreground="{DynamicResource MutedColor}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </shad:Card>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding SelectedVirtualMicrophonesSummary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ForegroundColor}" />
                                            <avalonia:MaterialIcon Grid.Column="1"
                                                                   Kind="ChevronDown"
                                                                   Width="16" Height="16"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource MutedColor}" />
                                        </Grid>
                                </Button>

                                <TextBlock Grid.Row="2" Grid.Column="3"
                                           Text="{x:Static lang:Resources.Speech_PlaybackOutputs}"
                                           Classes="Small SpeechConfigLabel"
                                           IsVisible="{Binding IsVoiceTranslationMode}" />
                                <Button Grid.Row="2" Grid.Column="4"
                                        Classes="Outline SpeechConfigInput"
                                        Width="240"
                                        Padding="8,4"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        IsVisible="{Binding IsVoiceTranslationMode}">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom"
                                                    ShowMode="Standard"
                                                    FlyoutPresenterClasses="AudioSourceFlyout">
                                                <shad:Card MinWidth="320" MaxHeight="460"
                                                           Background="{DynamicResource DialogBackgroundColor}"
                                                           HasShadow="False">
                                                    <Grid RowDefinitions="Auto,*">
                                                        <TextBlock Text="{x:Static lang:Resources.Speech_PlaybackOutputs}"
                                                                   Classes="Small"
                                                                   Margin="12,10" />
                                                        <ScrollViewer Grid.Row="1"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      MaxHeight="390">
                                                            <ItemsControl ItemsSource="{Binding AudioOutputOptions}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  Margin="0,2"
                                                                                  Padding="6,4"
                                                                                  Background="Transparent"
                                                                                  CornerRadius="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <avalonia:MaterialIcon Kind="VolumeOff"
                                                                                                       Width="18" Height="18"
                                                                                                       IsVisible="{Binding IsNoOperation}"
                                                                                                       Foreground="{DynamicResource MutedColor}" />
                                                                                <StackPanel Spacing="1">
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource ForegroundColor}" />
                                                                                    <TextBlock Text="{Binding Description}"
                                                                                               Classes="Small"
                                                                                               IsVisible="{Binding HasDescription}"
                                                                                               Foreground="{DynamicResource MutedColor}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </shad:Card>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding SelectedAudioOutputsSummary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ForegroundColor}" />
                                            <avalonia:MaterialIcon Grid.Column="1"
                                                                   Kind="ChevronDown"
                                                                   Width="16" Height="16"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource MutedColor}" />
                                        </Grid>
                                </Button>

                                <Button Grid.Row="2" Grid.Column="4"
                                        Command="{Binding ToggleAudioTranslationCommand}"
                                        Classes="Primary"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding IsLiveCaptionsMode}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <avalonia:MaterialIcon Kind="{Binding AudioTranslationIcon}" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding AudioTranslationText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="3" Grid.Column="4"
                                        Command="{Binding ToggleRealtimeInterpretationCommand}"
                                        Classes="Primary"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding CanToggleRealtimeInterpretation}"
                                        IsVisible="{Binding IsVoiceTranslationMode}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <avalonia:MaterialIcon Kind="Microphone" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding RealtimeInterpretationText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </shad:Card>

                        <Border Grid.Row="0"
                                IsVisible="{Binding IsRealtimeInterpretationDriverMissing}"
                                Background="{DynamicResource DialogBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource LgCornerRadius}"
                                Padding="24"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel Spacing="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="460">
                                <avalonia:MaterialIcon Kind="VolumeOff" Width="32" Height="32"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedColor}" />
                                <TextBlock Text="{x:Static lang:Resources.Speech_VirtualCableRequiredTitle}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{x:Static lang:Resources.Speech_VirtualCableRequiredMessage}"
                                           Classes="Small"
                                           Foreground="{DynamicResource MutedColor}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8"
                                            Margin="0,4,0,0">
                                    <Button Command="{Binding OpenVirtualCableInstallationTutorialCommand}" Classes="Primary">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <avalonia:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" />
                                            <TextBlock Text="{x:Static lang:Resources.Speech_InstallDriverTutorial}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshVirtualCableCommand}" Classes="Outline">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <avalonia:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                            <TextBlock Text="{x:Static lang:Resources.Speech_RecheckVirtualCable}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SkipVirtualCableCheckCommand}" Classes="Text">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <avalonia:MaterialIcon Kind="ArrowRight" Width="16" Height="16" />
                                            <TextBlock Text="{x:Static lang:Resources.Speech_SkipVirtualCableCheck}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Subtitles Display -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding IsTranslationEnabled, Converter={x:Static converts:BoolToGridLengthConverter.Instance}}" />
                            </Grid.ColumnDefinitions>

                            <shad:Card Grid.Column="0" Margin="0,0,6,0" HasShadow="True">
                                <shad:Card.Header>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <shad:CardTitle Content="{x:Static lang:Resources.Speech_Recognized}"
                                                        VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding ClearHistoryCommand}"
                                                Classes="Icon"
                                                ToolTip.Tip="{x:Static lang:Resources.Speech_ClearHistory}">
                                            <avalonia:MaterialIcon Kind="DeleteSweep" Width="18" Height="18"
                                                                   Foreground="{DynamicResource MutedColor}"/>
                                        </Button>
                                    </Grid>
                                </shad:Card.Header>
                                <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding SubtitleItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GhostColor}"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource LgCornerRadius}"
                                                            Padding="10,12"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding Timestamp, StringFormat=\{0:hh\\:mm\\:ss\}}"
                                                                           Classes="Caption"
                                                                           Foreground="{DynamicResource MutedColor}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding OriginLabel}"
                                                                           Classes="Caption"
                                                                           Foreground="{DynamicResource PrimaryColor}"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding OriginalText}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="22"
                                                                       Foreground="{DynamicResource ForegroundColor}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </shad:Card>

                            <shad:Card Grid.Column="1" Margin="6,0,0,0" IsVisible="{Binding IsTranslationEnabled}" HasShadow="True">
                                <shad:Card.Header>
                                    <shad:CardTitle Content="{x:Static lang:Resources.Speech_Translated}" />
                                </shad:Card.Header>
                                <ScrollViewer>
                                         <ItemsControl ItemsSource="{Binding SubtitleItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GhostColor}"
                                                            BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource LgCornerRadius}"
                                                            Padding="10,12"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Timestamp, StringFormat=\{0:hh\\:mm\\:ss\}}"
                                                                           Classes="Caption"
                                                                           Foreground="{DynamicResource MutedColor}"
                                                                           HorizontalAlignment="Left"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding OriginLabel}"
                                                                               Classes="Caption"
                                                                               Foreground="{DynamicResource PrimaryColor}"/>
                                                                    <shad:Loading IsVisible="{Binding IsTranslating}" Width="16" Height="16"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Text="{Binding TranslatedText}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="22"
                                                                       Foreground="{DynamicResource PrimaryColor}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                            </shad:Card>
                        </Grid>
            </Grid>

            </Grid>
            
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="3"
                        IsVisible="{Binding IsNotSupported}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                 <avalonia:MaterialIcon Kind="AlertCircleOutline"
                                        Width="48" Height="48"
                                        Foreground="{DynamicResource MutedColor}"
                                        HorizontalAlignment="Center"/>
                 <TextBlock Text="{x:Static lang:Resources.Speech_NotSupported}"
                            Classes="Muted" TextWrapping="Wrap" LineHeight="18" Opacity="0.95"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420"/>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
