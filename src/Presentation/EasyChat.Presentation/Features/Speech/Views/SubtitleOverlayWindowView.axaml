<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasyChat.Presentation.Features.Speech;assembly=EasyChat.Presentation"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
        xmlns:speechConverters="clr-namespace:EasyChat.Presentation.Features.Speech;assembly=EasyChat.Presentation"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="150"
        x:Class="EasyChat.Presentation.Features.Speech.Views.SubtitleOverlayWindowView"
        x:DataType="vm:SpeechRecognitionViewModel"
        Title="SubtitleOverlayWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <!-- Root: unlocked hit-testable chrome; locked click-through except unlock control. -->
    <Grid Name="RootGrid">
        
        <!-- Window Container (Background + Toolbar) -->
        <!-- Visible when: Unlocked AND (Hovering OR Dragging) -->
        <!-- Actually, user said: "Mouse move to subtitle area -> show". -->
        <Border x:Name="MainBorder" 
                Background="{Binding BackgroundColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}"
                CornerRadius="8"
                Padding="10"
                Opacity="{Binding WindowOpacity}">
            
            <Border.Styles>
                <Style Selector="Border#MainBorder">
                    <Setter Property="IsVisible" Value="True"/> 
                </Style>
                <!-- If Locked, Hide the Main Background container clearly -->
                <Style Selector="Border#MainBorder[Tag=True]"> <!-- Tag bound to IsLocked -->
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                
                <!-- Hover Effect when Unlocked -->
                <!-- Ideally default opacity is 0 or low, and 1 on hover. -->
                <!-- But user configures 'WindowOpacity'. Let's assume that's the 'active' opacity. -->
                <!-- When NOT hovering, maybe hide it? -->
                <!-- User: "You think it should only show when mouse moves to subtitle area" -->
                
                <Style Selector="Grid:not(:pointerover) Border#BackgroundBorder">
                     <Setter Property="IsVisible" Value="False"/>
                </Style>
                
                <!-- Exception: If we are resizing/dragging, keep it visible? Hard to track in pure XAML. -->
                <!-- Simplification: Show on Hover. -->
            </Border.Styles>
            
            <!-- Bind Tag to IsLocked for style trigger -->
            <Border.Tag>
                <Binding Path="IsFloatingWindowLocked"/>
            </Border.Tag>
        </Border>

        <!-- 2. Subtitles Layer -->
        <!-- Added Top Margin to avoid overlapping the Toolbar area initially -->
        <ScrollViewer x:Name="SubtitlesScrollViewer"
                      VerticalScrollBarVisibility="Hidden" 
                      HorizontalScrollBarVisibility="Disabled" 
                      Margin="10,40,10,10"
                      IsHitTestVisible="{Binding !IsFloatingWindowLocked}">

            <ItemsControl ItemsSource="{Binding FloatingSubtitles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Subtitle Background Pill -->
                        <Border Background="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SubtitleBackgroundColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}"
                                 CornerRadius="4"
                                 Padding="8,4"
                                 Margin="0,2"
                                 Opacity="{Binding Opacity}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel>
                                <!-- Primary Subtitle -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" 
                                               FontFamily="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).PrimaryFontFamily, Converter={x:Static converts:StringToFontFamilyConverter.Instance}}"
                                               FontSize="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).PrimaryFontSize}"
                                               Foreground="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).PrimaryFontColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static speechConverters:SubtitleContentConverter.Instance}" ConverterParameter="Main">
                                                <Binding Path="OriginalText" />
                                                <Binding Path="DisplayTranslatedText" />
                                                <Binding Path="$parent[Window].((vm:SpeechRecognitionViewModel)DataContext).MainSubtitleSource" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <suki:Loading Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <suki:Loading.IsVisible>
                                            <MultiBinding Converter="{x:Static speechConverters:SubtitleLoadingConverter.Instance}" ConverterParameter="Main">
                                                <Binding Path="IsTranslating" />
                                                <Binding Path="$parent[Window].((vm:SpeechRecognitionViewModel)DataContext).MainSubtitleSource" />
                                            </MultiBinding>
                                        </suki:Loading.IsVisible>
                                    </suki:Loading>
                                </Grid>
                                
                                <!-- Secondary Subtitle -->
                                <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                    <Grid.IsVisible>
                                        <MultiBinding Converter="{x:Static speechConverters:SubtitleVisibilityConverter.Instance}" ConverterParameter="Secondary">
                                            <Binding Path="OriginalText" />
                                            <Binding Path="DisplayTranslatedText" />
                                            <Binding Path="$parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondarySubtitleSource" />
                                        </MultiBinding>
                                    </Grid.IsVisible>
                                    
                                    <TextBlock Grid.Column="0"
                                               FontFamily="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondaryFontFamily, Converter={x:Static converts:StringToFontFamilyConverter.Instance}}"
                                               FontSize="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondaryFontSize}"
                                               Foreground="{Binding $parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondaryFontColor, Converter={x:Static converts:ColorToBrushConverter.Instance}}"
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static speechConverters:SubtitleContentConverter.Instance}" ConverterParameter="Secondary">
                                                <Binding Path="OriginalText" />
                                                <Binding Path="DisplayTranslatedText" />
                                                <Binding Path="$parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondarySubtitleSource" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    
                                    <suki:Loading Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <suki:Loading.IsVisible>
                                            <MultiBinding Converter="{x:Static speechConverters:SubtitleLoadingConverter.Instance}" ConverterParameter="Secondary">
                                                <Binding Path="IsTranslating" />
                                                <Binding Path="$parent[Window].((vm:SpeechRecognitionViewModel)DataContext).SecondarySubtitleSource" />
                                            </MultiBinding>
                                        </suki:Loading.IsVisible>
                                    </suki:Loading>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Hover toolbar: lock / clear / close + font size -->
        <Border x:Name="Toolbar"
                Classes="EcFloatShell"
                Margin="10,10,10,0"
                Height="36"
                VerticalAlignment="Top"
                Padding="6,3"
                IsVisible="{Binding !IsFloatingWindowLocked}">

             <Border.Styles>
                <Style Selector="Grid:not(:pointerover) Border#Toolbar">
                     <Setter Property="IsVisible" Value="False"/>
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,*,Auto">
                <avalonia:MaterialIcon Kind="Drag" Width="15" Height="15" Opacity="0.5"
                                       VerticalAlignment="Center" Margin="4,0,6,0"
                                       Foreground="{DynamicResource EcTextMuted}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
                    <Button Command="{Binding IncreaseFontSizeCommand}" Classes="EcToolbarBtnSm"
                            ToolTip.Tip="{x:Static lang:Resources.FloatingWindow_IncreaseFont}"
                            AutomationProperties.Name="{x:Static lang:Resources.FloatingWindow_IncreaseFont}">
                        <TextBlock Text="A+" Foreground="{DynamicResource EcTextPrimary}"
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding DecreaseFontSizeCommand}" Classes="EcToolbarBtnSm"
                            ToolTip.Tip="{x:Static lang:Resources.FloatingWindow_DecreaseFont}"
                            AutomationProperties.Name="{x:Static lang:Resources.FloatingWindow_DecreaseFont}">
                        <TextBlock Text="A-" Foreground="{DynamicResource EcTextPrimary}"
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding ToggleLockCommand}" Classes="EcToolbarBtnSm"
                            ToolTip.Tip="{x:Static lang:Resources.FloatingWindow_Lock}"
                            AutomationProperties.Name="{x:Static lang:Resources.FloatingWindow_Lock}">
                        <avalonia:MaterialIcon Kind="LockOpen" Width="15" Height="15"
                                               Foreground="{DynamicResource EcTextPrimary}"/>
                    </Button>
                    <Button Command="{Binding ClearHistoryCommand}" Classes="EcToolbarBtnSm"
                            ToolTip.Tip="{x:Static lang:Resources.Speech_ClearHistory}"
                            AutomationProperties.Name="{x:Static lang:Resources.Speech_ClearHistory}">
                        <avalonia:MaterialIcon Kind="DeleteSweep" Width="15" Height="15"
                                               Foreground="{DynamicResource EcTextPrimary}"/>
                    </Button>
                    <Button Click="CloseButton_Click" Classes="EcToolbarBtnSm"
                            ToolTip.Tip="{x:Static lang:Resources.FloatingWindow_Close}"
                            AutomationProperties.Name="{x:Static lang:Resources.FloatingWindow_Close}">
                        <avalonia:MaterialIcon Kind="Close" Width="15" Height="15"
                                               Foreground="{DynamicResource EcTextPrimary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Locked chrome: click-through elsewhere, but drag + unlock stay interactive. -->
        <Border x:Name="LockedChrome"
                Classes="EcFloatShell"
                Padding="4,3"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="8"
                IsVisible="{Binding IsFloatingWindowLocked}"
                Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Border x:Name="LockedDragHandle"
                        Padding="6,4"
                        CornerRadius="6"
                        Cursor="SizeAll"
                        Background="Transparent"
                        ToolTip.Tip="{x:Static lang:Resources.FloatingWindow}"
                        PointerPressed="OnLockedDragPointerPressed">
                    <avalonia:MaterialIcon Kind="Drag" Width="16" Height="16"
                                           Foreground="{DynamicResource EcTextPrimary}"
                                           Opacity="0.85"/>
                </Border>
                <Button x:Name="UnlockBtn"
                        Command="{Binding ToggleLockCommand}"
                        Classes="EcToolbarBtnSm"
                        ToolTip.Tip="{x:Static lang:Resources.FloatingWindow_Unlock}"
                        AutomationProperties.Name="{x:Static lang:Resources.FloatingWindow_Unlock}">
                    <avalonia:MaterialIcon Kind="Lock" Width="15" Height="15"
                                           Foreground="{DynamicResource EcTextPrimary}" Opacity="0.9"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Resize Grip -->
         <avalonia:MaterialIcon Kind="ResizeBottomRight"
                               Width="24" Height="24"
                               Foreground="{DynamicResource EcTextPrimary}"
                               Opacity="0.75"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Right"
                               Cursor="BottomRightCorner"
                               PointerPressed="OnResizePointerPressed">
             <avalonia:MaterialIcon.IsVisible>
                 <MultiBinding Converter="{x:Static BoolConverters.And}">
                     <Binding Path="!IsFloatingWindowLocked"/>
                     <Binding Path="#RootGrid.IsPointerOver"/> <!-- Only show resize grip on hover too? -->
                 </MultiBinding>
             </avalonia:MaterialIcon.IsVisible>
         </avalonia:MaterialIcon>
    </Grid>
</Window>
