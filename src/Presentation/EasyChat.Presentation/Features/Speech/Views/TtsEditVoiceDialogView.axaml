<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.TtsEditVoiceDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Speech"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:DataType="viewModels:TtsEditVoiceDialogViewModel"
             MinWidth="460"
             MaxWidth="520"
             Width="500"
             Height="600">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EcDialogHeader">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource EcAccentSoft}">
                    <avalonia:MaterialIcon Kind="AccountVoice"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EcAccent}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="EcDialogTitle"
                           Text="{x:Static lang:Resources.Tts_EditVoiceMapping}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="EcDialogScroll" MaxHeight="480">
            <StackPanel Classes="EcDialogBody">
                <!-- Language Selection -->
                <StackPanel>
                    <TextBlock Classes="EcFieldLabel" Text="{x:Static lang:Resources.Language}"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              HorizontalAlignment="Stretch"
                              Classes="Outline"
                              MaxDropDownHeight="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border ClipToBounds="True" CornerRadius="2" Width="20" Height="14"
                                            IsVisible="{Binding Icon, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}">
                                        <Image Source="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.ToIcon}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Voice Selection -->
                <StackPanel>
                    <TextBlock Classes="EcFieldLabel" Text="{x:Static lang:Resources.Tts_Voice}"/>
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="{x:Static lang:Resources.Tts_SearchVoices}"
                             Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource EcBgMuted}"
                            BorderBrush="{DynamicResource EcBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4">
                        <ListBox ItemsSource="{Binding FilteredVoices}"
                                 SelectedItem="{Binding SelectedVoice}"
                                 Height="300"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="4,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:MaterialIcon Kind="AccountVoice" Width="16" Height="16"
                                                                   Foreground="{DynamicResource EcAccent}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource EcTextPrimary}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding LanguageId}" FontSize="11"
                                                       Foreground="{DynamicResource EcTextSecondary}"/>
                                            <TextBlock Text="{Binding Gender}" FontSize="11"
                                                       Foreground="{DynamicResource EcTextSecondary}"/>
                                            <TextBlock Text="{Binding Id}" FontSize="11"
                                                       Foreground="{DynamicResource EcTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="EcDialogFooter">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" Classes="EcGhost" MinWidth="88"
                        Content="{x:Static lang:Resources.Cancel}" />
                <Button Command="{Binding PreviewCommand}" Classes="EcGhost"
                        ToolTip.Tip="{x:Static lang:Resources.Tts_PreviewVoice}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Tts_PreviewVoice}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}" Classes="EcPrimary" MinWidth="96"
                        Content="{x:Static lang:Resources.Save}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
