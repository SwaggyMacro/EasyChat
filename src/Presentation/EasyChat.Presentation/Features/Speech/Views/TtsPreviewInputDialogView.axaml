<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.TtsPreviewInputDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Speech"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:DataType="viewModels:TtsPreviewInputDialogViewModel"
             MinWidth="360"
             MaxWidth="420"
             Width="400">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18,22,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource PrimaryColor10}">
                    <avalonia:MaterialIcon Kind="PlayCircleOutline"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryColor}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="Large" TextWrapping="Wrap"
                           Text="{x:Static lang:Resources.Tts_PreviewVoice}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" Padding="22,0" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock Text="{x:Static lang:Resources.Tts_PreviewInputPrompt}"
                           Classes="Muted" TextWrapping="Wrap" />
                <TextBox Text="{Binding InputText}"
                         AcceptsReturn="True"
                         Height="100"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="DialogFooter" Margin="0,12,0,0" Padding="22,14,22,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Command="{Binding CloseCommand}"
                        Classes="Ghost"
                        MinWidth="88"
                        Content="{x:Static lang:Resources.Close}" />
                <Button Classes="Primary"
                        MinWidth="96"
                        Command="{Binding PlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsHitTestVisible="False">
                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16"
                                               IsVisible="{Binding ShowPlayIcon}" />
                        <avalonia:MaterialIcon Kind="Stop" Width="16" Height="16"
                                               IsVisible="{Binding IsPlaying}" />
                        <shad:Loading IsVisible="{Binding IsLoading}" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Tts_Play}" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowPlayIcon}" />
                        <TextBlock Text="{x:Static lang:Resources.LongScreenshot_Stop}" VerticalAlignment="Center"
                                   IsVisible="{Binding IsPlaying}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
