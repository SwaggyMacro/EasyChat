<UserControl x:Class="EasyChat.Presentation.Features.Speech.Views.TtsPreviewInputDialogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Speech"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:DataType="viewModels:TtsPreviewInputDialogViewModel"
             MinWidth="360"
             MaxWidth="420"
             Width="400">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="EcDialogHeader">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource EcAccentSoft}">
                    <avalonia:MaterialIcon Kind="PlayCircleOutline"
                                           Width="20" Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource EcAccent}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="EcDialogTitle"
                           Text="{x:Static lang:Resources.Tts_PreviewVoice}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="EcDialogScroll">
            <StackPanel Classes="EcDialogBody">
                <TextBlock Text="{x:Static lang:Resources.Tts_PreviewInputPrompt}"
                           Classes="EcHelper" />
                <TextBox Text="{Binding InputText}"
                         AcceptsReturn="True"
                         Height="100"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="EcDialogFooter">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Command="{Binding CloseCommand}"
                        Classes="EcGhost"
                        MinWidth="88"
                        Content="{x:Static lang:Resources.Close}" />
                <Button Classes="EcPrimary"
                        MinWidth="96"
                        Command="{Binding PlayCommand}"
                        IsEnabled="{Binding !IsPlaying}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="Play" Width="16" Height="16"
                                               IsVisible="{Binding !IsPlaying}" />
                        <suki:Loading IsVisible="{Binding IsPlaying}" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Tts_Play}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
