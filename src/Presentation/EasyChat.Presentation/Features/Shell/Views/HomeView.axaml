<UserControl x:Class="EasyChat.Presentation.Features.Shell.Views.HomeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Shell"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             d:DesignWidth="1100"
             d:DesignHeight="740"
             x:DataType="viewModels:HomeViewModel"
             mc:Ignorable="d"
             Background="{DynamicResource EcBgCanvas}">
    <!--
      Prefer layout over fake widgets: hero metrics + split main that fills the pane.
      Left = setup, right = 2×2 actions (stretch cells, content vertically centered).
    -->
    <Grid Margin="28,22,28,24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="14">

        <!-- Hero: engine + 3 metric chips -->
        <Border Grid.Row="0"
                Background="{DynamicResource EcBgElevated}"
                BorderBrush="{DynamicResource EcBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18,16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Background="{DynamicResource EcAccentSoft}"
                            VerticalAlignment="Center">
                        <avalonia:MaterialIcon Kind="RocketLaunch"
                                               Width="20" Height="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcAccent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding EngineSummaryText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource EcTextPrimary}"
                                       VerticalAlignment="Center" />
                            <ec:EcStatusPill Text="{Binding EngineStatusText}"
                                             Kind="{Binding EngineStatusKind}"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineKindText}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource EcTextMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="EcPrimary"
                                Command="{Binding NavigateToSettingsCommand}"
                                IsVisible="{Binding NeedsConfiguration}"
                                Padding="12,7"
                                FontSize="12.5"
                                Content="{x:Static lang:Resources.HomeConfigureCta}" />
                        <Button Classes="EcGhost"
                                Command="{Binding OpenEngineSettingsCommand}"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Static lang:Resources.TransEngine}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <avalonia:MaterialIcon Kind="ChevronRight" Width="14" Height="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Real snapshot chips (not decorative filler) -->
                <UniformGrid Grid.Row="1" Columns="3">
                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource EcBgMuted}"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.HomeLanguagePair}"
                                       FontSize="11"
                                       Foreground="{DynamicResource EcTextMuted}" />
                            <TextBlock Text="{Binding LanguagePairDisplay}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource EcTextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0"
                            Background="{DynamicResource EcBgMuted}"
                            CornerRadius="12"
                            Padding="14,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.AIEngine}"
                                       FontSize="11"
                                       Foreground="{DynamicResource EcTextMuted}" />
                            <TextBlock Text="{Binding ConfiguredModelCount, StringFormat={}{0}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource EcTextPrimary}" />
                            <TextBlock Text="{Binding EngineKindText}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource EcTextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Button Margin="8,0,0,0"
                            Background="{DynamicResource EcBgMuted}"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="14,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            Command="{Binding NavigateToShortcutsCommand}"
                            Cursor="Hand">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static lang:Resources.Shortcut}"
                                       FontSize="11"
                                       Foreground="{DynamicResource EcTextMuted}" />
                            <TextBlock Text="{Binding ShortcutCount, StringFormat={}{0}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource EcTextPrimary}" />
                            <TextBlock Text="{x:Static lang:Resources.HomeHealthActionOpenShortcuts}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource EcAccent}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Onboarding -->
        <Border Grid.Row="1"
                IsVisible="{Binding ShowOnboarding}"
                Background="{DynamicResource EcAccentSoft}"
                BorderBrush="{DynamicResource EcAccentMuted}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingTitle}"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               Foreground="{DynamicResource EcTextPrimary}" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep1}"
                               FontSize="12"
                               Foreground="{DynamicResource EcTextSecondary}" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep2}"
                               FontSize="12"
                               Foreground="{DynamicResource EcTextSecondary}" />
                    <TextBlock Text="{x:Static lang:Resources.HomeOnboardingStep3}"
                               FontSize="12"
                               Foreground="{DynamicResource EcTextSecondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Classes="EcPrimary"
                                Command="{Binding NavigateToSettingsCommand}"
                                Content="{x:Static lang:Resources.HomeHealthActionOpenSettings}"
                                Padding="10,5"
                                FontSize="12" />
                        <Button Classes="EcGhost"
                                Command="{Binding NavigateToShortcutsCommand}"
                                Content="{x:Static lang:Resources.HomeHealthActionOpenShortcuts}"
                                Padding="10,5"
                                FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="EcToolbarBtn"
                        VerticalAlignment="Top"
                        Command="{Binding DismissOnboardingCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.HomeOnboardingDismiss}">
                    <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" />
                </Button>
            </Grid>
        </Border>

        <!--
          Setup stays natural height (no Dock top/bottom stretch — that left a white void).
          Engine | languages sit side-by-side, tightly packed.
        -->
        <!--
          Setup: shared rows so 翻译方向 lines up with 翻译引擎 (not top-stuck on the right).
          Row0 labels · Row1 controls (segment | language pair) · bottom edges match.
        -->
        <Border Grid.Row="2"
                Background="{DynamicResource EcBgElevated}"
                BorderBrush="{DynamicResource EcBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18,16">
            <Grid ColumnDefinitions="*,20,*"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="12">
                <TextBlock Text="{x:Static lang:Resources.TransEngine}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{x:Static lang:Resources.HomeLanguagePair}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextMuted}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Row="1" Spacing="10">
                    <Border Classes="EcSegmented" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton Classes="EcSegment"
                                         GroupName="HomeEngine"
                                         Content="{x:Static lang:Resources.AIEngine}"
                                         IsChecked="{Binding GeneralConfig.TransEngine,
                                                     Converter={x:Static converters:EngineTypeToBoolConverters.AiModel}}" />
                            <RadioButton Classes="EcSegment"
                                         GroupName="HomeEngine"
                                         Content="{x:Static lang:Resources.MachineTranslation}"
                                         IsChecked="{Binding GeneralConfig.TransEngine,
                                                     Converter={x:Static converters:EngineTypeToBoolConverters.MachineTrans}}" />
                        </StackPanel>
                    </Border>
                    <ComboBox HorizontalAlignment="Stretch"
                              MinHeight="38"
                              ItemsSource="{Binding ConfiguredModels}"
                              SelectedValue="{Binding GeneralConfig.UsingAiModelId}"
                              SelectedValueBinding="{Binding Id}"
                              IsVisible="{Binding GeneralConfig.TransEngine,
                                          Converter={x:Static converters:EngineTypeToBoolConverters.AiModel}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="4" ClipToBounds="True">
                                        <Image Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox HorizontalAlignment="Stretch"
                              MinHeight="38"
                              ItemsSource="{Binding MachineTransProviders}"
                              SelectedItem="{Binding GeneralConfig.UsingMachineTrans}"
                              IsVisible="{Binding GeneralConfig.TransEngine,
                                          Converter={x:Static converters:EngineTypeToBoolConverters.MachineTrans}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="18" Height="18">
                                        <Border ClipToBounds="True" CornerRadius="4"
                                                IsVisible="{Binding Converter={x:Static converters:EngineConverters.HasIcon}}">
                                            <Image Source="{Binding Converter={x:Static converters:EngineConverters.ToIcon}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                               IsVisible="{Binding Converter={x:Static converters:EngineConverters.HasNoIcon}}" />
                                    </Panel>
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Sit lower to balance the left engine stack (segment + combo). -->
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Static lang:Resources.SourceLang}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource EcTextMuted}" />
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedSourceLanguage}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="38">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="16" Height="16"
                                                   Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" />
                                            <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EcTextPrimary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="EcIconRound"
                                Width="36" Height="36"
                                Command="{Binding SwapLanguagesCommand}"
                                ToolTip.Tip="{x:Static lang:Resources.HomeSwapLanguages}"
                                VerticalAlignment="Bottom">
                            <avalonia:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" />
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="{x:Static lang:Resources.TargetLang}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource EcTextMuted}" />
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedTargetLanguage}"
                                      HorizontalAlignment="Stretch"
                                      MinHeight="38">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="16" Height="16"
                                                   Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" />
                                            <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EcTextPrimary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick actions: compact fixed height (no * stretch, no oversized MinHeight) -->
        <Border Grid.Row="3"
                Background="{DynamicResource EcBgElevated}"
                BorderBrush="{DynamicResource EcBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,12"
                VerticalAlignment="Top">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{x:Static lang:Resources.HomeQuickActions}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextMuted}"
                           Margin="2,0,0,10" />
                <ItemsControl ItemsSource="{Binding QuickActions}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:HomeQuickAction">
                            <Button Command="{Binding Command}"
                                    Margin="4"
                                    Height="72"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Background="{DynamicResource EcBgMuted}"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Padding="{TemplateBinding Padding}"
                                                Height="{TemplateBinding Height}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource EcAccentSoft}" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32"
                                            CornerRadius="9"
                                            Background="{DynamicResource EcBgElevated}"
                                            BorderBrush="{DynamicResource EcBorder}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                               Width="16" Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EcAccent}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource EcTextPrimary}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11.5"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource EcTextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Footer: plain meta line with breathing room above -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,4,2,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Static lang:Resources.CurrentVersion}"
                           FontSize="11.5"
                           Foreground="{DynamicResource EcTextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentVersion}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·"
                           FontSize="11.5"
                           Foreground="{DynamicResource EcTextMuted}"
                           Margin="2,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Static lang:Resources.LatestVersion}"
                           FontSize="11.5"
                           Foreground="{DynamicResource EcTextMuted}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LatestVersion}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextSecondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="EcGhost"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,2"
                    Cursor="Hand"
                    Command="{Binding NavigateToAboutCommand}"
                    HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="{x:Static lang:Resources.About}"
                               FontSize="11.5"
                               Foreground="{DynamicResource EcTextMuted}"
                               VerticalAlignment="Center" />
                    <avalonia:MaterialIcon Kind="ChevronRight"
                                           Width="14" Height="14"
                                           Foreground="{DynamicResource EcTextMuted}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
