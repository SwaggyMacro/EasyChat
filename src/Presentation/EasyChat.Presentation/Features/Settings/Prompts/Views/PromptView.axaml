<UserControl x:Class="EasyChat.Presentation.Features.Settings.Prompts.Views.PromptView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings.Prompts;assembly=EasyChat.Presentation"
             xmlns:state="clr-namespace:EasyChat.Presentation.Features.Settings.State;assembly=EasyChat.Presentation"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             x:DataType="viewModels:PromptViewModel"
             mc:Ignorable="d"
             Focusable="True"
             Background="{DynamicResource EcBgCanvas}">

    <Grid Classes="EcPageFrame"
          RowDefinitions="Auto,*">

        <ec:EcPageHeader Title="{x:Static lang:Resources.Prompts}"
                         Subtitle="{x:Static lang:Resources.PromptParametersHint}">
            <ec:EcPageHeader.Actions>
                <Button Classes="EcPrimary" Command="{Binding AddPromptCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.AddPrompt}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ec:EcPageHeader.Actions>
        </ec:EcPageHeader>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Border Classes="EcSurface"
                    IsVisible="{Binding HasNoPrompts}"
                    Padding="28"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                    <avalonia:MaterialIcon Kind="TextBox"
                                           Width="36" Height="36"
                                           Opacity="0.45"
                                           HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static lang:Resources.PromptParametersHint}"
                               Classes="EcHelper"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Button Classes="EcPrimary"
                            HorizontalAlignment="Center"
                            Command="{Binding AddPromptCommand}"
                            Content="{x:Static lang:Resources.AddPrompt}" />
                </StackPanel>
            </Border>

            <ScrollViewer IsVisible="{Binding HasPrompts}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Classes="EcStackList" ItemsSource="{Binding Prompts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="state:PromptEntryState">
                            <Border Classes="EcSurface"
                                    Margin="0,0,0,12"
                                    Padding="16"
                                    HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Button Classes="EcMenuItem"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="4,2"
                                            Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).EditPromptCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static lang:Resources.Edit}">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource EcTextPrimary}" />
                                                <Border IsVisible="{Binding IsDefault}"
                                                        Background="{DynamicResource EcAccent}"
                                                        CornerRadius="999"
                                                        Padding="10,3">
                                                    <TextBlock Text="{x:Static lang:Resources.DefaultPrompt}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ContentPreview}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource EcTextSecondary}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Row body already opens edit; keep default + delete only. -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button Classes="EcToolbarBtn"
                                                Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).SetDefaultCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsDefault}"
                                                ToolTip.Tip="{x:Static lang:Resources.SetAsDefault}">
                                            <avalonia:MaterialIcon Kind="StarOutline" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="EcDanger"
                                                Command="{Binding $parent[ItemsControl].((viewModels:PromptViewModel)DataContext).RemovePromptCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                            <avalonia:MaterialIcon Kind="TrashCan" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
