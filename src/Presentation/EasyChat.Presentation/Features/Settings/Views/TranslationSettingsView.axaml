<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.TranslationSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             x:DataType="viewModels:SettingViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <!-- Full-width provider/model rows — never fixed card width -->
        <Style Selector="Border.ProviderRow">
            <Setter Property="Background" Value="{DynamicResource EcBgMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EcBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource EcRadiusMd}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="72" />
        </Style>
        <Style Selector="Border.ProviderRow StackPanel.RowActions">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.ProviderRow:pointerover StackPanel.RowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.RowIconBtn, ToggleButton.RowIconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Styles>

    <!-- No outer EcSurface / ScrollViewer: SettingView already provides both. -->
    <TabControl>
            <!-- AI models: vertical full-width list -->
            <TabItem Header="{x:Static lang:Resources.AIEngine}">
                    <StackPanel Spacing="0" Margin="0,8,0,0">
                        <ItemsControl Classes="EcStackList"
                                      ItemsSource="{Binding ModelCardsWithAddButton}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Panel>
                                        <!-- Model row -->
                                        <Border Classes="ProviderRow" IsVisible="{Binding IsModelCard}">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="10"
                                                            Background="{DynamicResource EcAccentSoft}"
                                                            ClipToBounds="True">
                                                        <Image Width="22" Height="22"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Source="{Binding ModelType, Converter={x:Static converts:AiModelTypeConverters.ToIcon}}"
                                                               Stretch="Uniform" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource EcTextPrimary}" />
                                                        <TextBlock Text="{Binding ModelType}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource EcTextMuted}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"
                                                                Classes="RowActions"
                                                                Orientation="Horizontal"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <ToggleButton Classes="RowIconBtn"
                                                                      IsChecked="{Binding Model.UseProxy}"
                                                                      ToolTip.Tip="{x:Static lang:Resources.UseProxy}">
                                                            <avalonia:MaterialIcon Kind="Vpn" Width="18" Height="18">
                                                                <avalonia:MaterialIcon.Foreground>
                                                                    <MultiBinding Converter="{x:Static converts:BoolToColorConverter.Instance}">
                                                                        <Binding Path="Model.UseProxy" />
                                                                    </MultiBinding>
                                                                </avalonia:MaterialIcon.Foreground>
                                                            </avalonia:MaterialIcon>
                                                        </ToggleButton>
                                                        <Button Classes="RowIconBtn"
                                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).TestAiModelConnectionCommand}"
                                                                CommandParameter="{Binding Model}"
                                                                ToolTip.Tip="{x:Static lang:Resources.TestConnection}">
                                                            <Panel>
                                                                <avalonia:MaterialIcon Kind="Connection" Width="16" Height="16"
                                                                        IsVisible="{Binding Model.IsTesting, Converter={x:Static BoolConverters.Not}}" />
                                                                <suki:Loading Width="16" Height="16"
                                                                              IsVisible="{Binding Model.IsTesting}" />
                                                            </Panel>
                                                        </Button>
                                                        <Button Classes="RowIconBtn"
                                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).EditModelCommand}"
                                                                CommandParameter="{Binding Model}"
                                                                ToolTip.Tip="{x:Static lang:Resources.Edit}">
                                                            <avalonia:MaterialIcon Kind="Pencil" Width="16" Height="16"
                                                                                   Foreground="{DynamicResource EcTextSecondary}" />
                                                        </Button>
                                                        <Button Classes="RowIconBtn"
                                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).DeleteModelCommand}"
                                                                CommandParameter="{Binding Model}"
                                                                ToolTip.Tip="{x:Static lang:Resources.Delete}">
                                                            <avalonia:MaterialIcon Kind="TrashCan" Width="16" Height="16"
                                                                                   Foreground="{DynamicResource EcDanger}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1"
                                                      ColumnDefinitions="Auto,*,Auto,Auto"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="API"
                                                               Classes="EcMuted"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               MinWidth="36" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ApiUrl}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EcTextSecondary}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Model.ApiKeys.Count, StringFormat='{}{0} keys'}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource EcTextMuted}" />
                                                    <Button Grid.Column="3"
                                                            Classes="EcGhost"
                                                            Padding="10,4"
                                                            Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).EditModelKeysCommand}"
                                                            CommandParameter="{Binding Model}">
                                                        <TextBlock Text="{x:Static lang:Resources.EditKeys}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Add model: dedicated EcAddRow (own template, not nested Button+Border) -->
                                        <Button Classes="EcAddRow"
                                                IsVisible="{Binding IsAddButton}"
                                                Command="{Binding $parent[ItemsControl].((viewModels:SettingViewModel)DataContext).AddModelCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="36" Height="36" CornerRadius="10"
                                                        Background="{DynamicResource EcAccentMuted}">
                                                    <avalonia:MaterialIcon Kind="Plus" Width="18" Height="18"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource EcAccent}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Static lang:Resources.AddModel}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource EcTextPrimary}" />
                                                    <TextBlock Text="{x:Static lang:Resources.HomeConfigureCta}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource EcTextMuted}" />
                                                </StackPanel>
                                                <avalonia:MaterialIcon Grid.Column="2"
                                                                       Kind="ChevronRight"
                                                                       Width="16" Height="16"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource EcTextMuted}" />
                                            </Grid>
                                        </Button>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </TabItem>

            <!-- Machine engines: same full-width row pattern -->
            <TabItem Header="{x:Static lang:Resources.TransEngine}">
                    <StackPanel Margin="0,8,0,0">

                        <!-- Baidu -->
                        <Border Classes="ProviderRow">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource EcAccentSoft}">
                                        <Image Source="avares://EasyChat.Desktop/Assets/Images/Engine/Baidu.png"
                                               Width="22" Height="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static lang:Resources.Baidu}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                    <StackPanel Grid.Column="2" Classes="RowActions" Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="RowIconBtn"
                                                      IsChecked="{Binding MachineTransConf.Baidu.UseProxy}"
                                                      ToolTip.Tip="{x:Static lang:Resources.UseProxy}">
                                            <avalonia:MaterialIcon Kind="Vpn" Width="18" Height="18">
                                                <avalonia:MaterialIcon.Foreground>
                                                    <MultiBinding Converter="{x:Static converts:BoolToColorConverter.Instance}">
                                                        <Binding Path="MachineTransConf.Baidu.UseProxy" />
                                                    </MultiBinding>
                                                </avalonia:MaterialIcon.Foreground>
                                            </avalonia:MaterialIcon>
                                        </ToggleButton>
                                        <Button Classes="RowIconBtn"
                                                Command="{Binding TestBaiduConnectionCommand}"
                                                ToolTip.Tip="{x:Static lang:Resources.TestConnection}">
                                            <Panel>
                                                <avalonia:MaterialIcon Kind="Connection" Width="18" Height="18"
                                                        IsVisible="{Binding !IsTestingBaidu}" />
                                                <suki:Loading Width="18" Height="18"
                                                              IsVisible="{Binding IsTestingBaidu}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Keys}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MachineTransConf.Baidu.Items.Count, StringFormat='{}{0} keys'}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextSecondary}" />
                                    <Button Grid.Column="2" Classes="EcGhost" Padding="10,4"
                                            Command="{Binding EditBaiduKeysCommand}">
                                        <TextBlock Text="{x:Static lang:Resources.EditKeys}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tencent -->
                        <Border Classes="ProviderRow">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource EcAccentSoft}">
                                        <Image Source="avares://EasyChat.Desktop/Assets/Images/Engine/Tencent.png"
                                               Width="22" Height="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static lang:Resources.Tencent}"
                                               FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                    <StackPanel Grid.Column="2" Classes="RowActions" Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="RowIconBtn"
                                                      IsChecked="{Binding MachineTransConf.Tencent.UseProxy}"
                                                      ToolTip.Tip="{x:Static lang:Resources.UseProxy}">
                                            <avalonia:MaterialIcon Kind="Vpn" Width="18" Height="18">
                                                <avalonia:MaterialIcon.Foreground>
                                                    <MultiBinding Converter="{x:Static converts:BoolToColorConverter.Instance}">
                                                        <Binding Path="MachineTransConf.Tencent.UseProxy" />
                                                    </MultiBinding>
                                                </avalonia:MaterialIcon.Foreground>
                                            </avalonia:MaterialIcon>
                                        </ToggleButton>
                                        <Button Classes="RowIconBtn"
                                                Command="{Binding TestTencentConnectionCommand}"
                                                ToolTip.Tip="{x:Static lang:Resources.TestConnection}">
                                            <Panel>
                                                <avalonia:MaterialIcon Kind="Connection" Width="18" Height="18"
                                                        IsVisible="{Binding !IsTestingTencent}" />
                                                <suki:Loading Width="18" Height="18"
                                                              IsVisible="{Binding IsTestingTencent}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Keys}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MachineTransConf.Tencent.Items.Count, StringFormat='{}{0} keys'}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextSecondary}" />
                                    <Button Grid.Column="2" Classes="EcGhost" Padding="10,4"
                                            Command="{Binding EditTencentKeysCommand}">
                                        <TextBlock Text="{x:Static lang:Resources.EditKeys}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Google -->
                        <Border Classes="ProviderRow">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource EcAccentSoft}">
                                        <Image Source="avares://EasyChat.Desktop/Assets/Images/Engine/Google.png"
                                               Width="22" Height="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static lang:Resources.Google}"
                                               FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                    <StackPanel Grid.Column="2" Classes="RowActions" Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="RowIconBtn"
                                                      IsChecked="{Binding MachineTransConf.Google.UseProxy}"
                                                      ToolTip.Tip="{x:Static lang:Resources.UseProxy}">
                                            <avalonia:MaterialIcon Kind="Vpn" Width="18" Height="18">
                                                <avalonia:MaterialIcon.Foreground>
                                                    <MultiBinding Converter="{x:Static converts:BoolToColorConverter.Instance}">
                                                        <Binding Path="MachineTransConf.Google.UseProxy" />
                                                    </MultiBinding>
                                                </avalonia:MaterialIcon.Foreground>
                                            </avalonia:MaterialIcon>
                                        </ToggleButton>
                                        <Button Classes="RowIconBtn"
                                                Command="{Binding TestGoogleConnectionCommand}"
                                                ToolTip.Tip="{x:Static lang:Resources.TestConnection}">
                                            <Panel>
                                                <avalonia:MaterialIcon Kind="Connection" Width="18" Height="18"
                                                        IsVisible="{Binding !IsTestingGoogle}" />
                                                <suki:Loading Width="18" Height="18"
                                                              IsVisible="{Binding IsTestingGoogle}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Model}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding MachineTransConf.Google.Model}"
                                             HorizontalAlignment="Stretch"
                                             suki:TextBoxExtensions.AddDeleteButton="True" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Keys}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MachineTransConf.Google.ApiKeys.Count, StringFormat='{}{0} keys'}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextSecondary}" />
                                    <Button Grid.Column="2" Classes="EcGhost" Padding="10,4"
                                            Command="{Binding EditGoogleKeysCommand}">
                                        <TextBlock Text="{x:Static lang:Resources.EditKeys}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- DeepL -->
                        <Border Classes="ProviderRow">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource EcAccentSoft}">
                                        <Image Source="avares://EasyChat.Desktop/Assets/Images/Engine/DeepL.png"
                                               Width="22" Height="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Static lang:Resources.DeepL}"
                                               FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                    <StackPanel Grid.Column="2" Classes="RowActions" Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="RowIconBtn"
                                                      IsChecked="{Binding MachineTransConf.DeepL.UseProxy}"
                                                      ToolTip.Tip="{x:Static lang:Resources.UseProxy}">
                                            <avalonia:MaterialIcon Kind="Vpn" Width="18" Height="18">
                                                <avalonia:MaterialIcon.Foreground>
                                                    <MultiBinding Converter="{x:Static converts:BoolToColorConverter.Instance}">
                                                        <Binding Path="MachineTransConf.DeepL.UseProxy" />
                                                    </MultiBinding>
                                                </avalonia:MaterialIcon.Foreground>
                                            </avalonia:MaterialIcon>
                                        </ToggleButton>
                                        <Button Classes="RowIconBtn"
                                                Command="{Binding TestDeepLConnectionCommand}"
                                                ToolTip.Tip="{x:Static lang:Resources.TestConnection}">
                                            <Panel>
                                                <avalonia:MaterialIcon Kind="Connection" Width="18" Height="18"
                                                        IsVisible="{Binding !IsTestingDeepL}" />
                                                <suki:Loading Width="18" Height="18"
                                                              IsVisible="{Binding IsTestingDeepL}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Model}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding DeepLModelTypes}"
                                              SelectedItem="{Binding MachineTransConf.DeepL.ModelType}" />
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.Keys}"
                                               Classes="EcMuted" FontSize="12"
                                               VerticalAlignment="Center" MinWidth="36" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MachineTransConf.DeepL.ApiKeys.Count, StringFormat='{}{0} keys'}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcTextSecondary}" />
                                    <Button Grid.Column="2" Classes="EcGhost" Padding="10,4"
                                            Command="{Binding EditDeepLKeysCommand}">
                                        <TextBlock Text="{x:Static lang:Resources.EditKeys}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
            </TabItem>
    </TabControl>
</UserControl>
