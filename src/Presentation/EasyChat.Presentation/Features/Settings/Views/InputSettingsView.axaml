<UserControl x:Class="EasyChat.Presentation.Features.Settings.Views.InputSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EasyChat.Presentation.Features.Settings"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang;assembly=EasyChat.Presentation"
             xmlns:converts="clr-namespace:EasyChat.Presentation.Features.Settings;assembly=EasyChat.Presentation"
             xmlns:formatting="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="viewModels:SettingViewModel"
             mc:Ignorable="d">
    <UserControl.Resources>
        <formatting:ColorToHexConverter x:Key="ColorToHexConverter" />
        <converts:DeliveryModeToBoolConverter x:Key="DeliveryModeToBoolConverter" />
        <converts:DeliveryModeToStringConverter x:Key="DeliveryModeToStringConverter" />
        <converts:InputTranslationModeToStringConverter x:Key="InputTranslationModeToStringConverter" />
    </UserControl.Resources>
    <StackPanel
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch" Spacing="0">
            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='transparency level acrylic blur 透明度级别 透明度 透明'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <TextBlock Text="{x:Static lang:Resources.TransparencyLevel}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding TransparencyLevels}"
                              SelectedItem="{Binding InputConf.TransparencyLevel}"
                              HorizontalAlignment="Stretch" />
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='background color 背景颜色 背景'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <TextBlock Text="{x:Static lang:Resources.BackgroundColor}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ColorPicker Color="{Binding InputConf.BackgroundColor, Converter={StaticResource ColorToHexConverter}, Mode=TwoWay}"
                                 IsAlphaEnabled="True"
                                 HorizontalAlignment="Stretch" />
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='font color 字体颜色 字体 颜色'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <TextBlock Text="{x:Static lang:Resources.FontColor}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ColorPicker Color="{Binding InputConf.FontColor, Converter={StaticResource ColorToHexConverter}, Mode=TwoWay}"
                                 IsAlphaEnabled="True"
                                 HorizontalAlignment="Stretch" />
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='input delivery mode delivery paste type message 文本投递模式 投递 粘贴 消息'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <TextBlock Text="{x:Static lang:Resources.InputDeliveryMode}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding InputDeliveryModes}"
                              SelectedItem="{Binding InputConf.DeliveryMode}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DeliveryModeToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding InputConf.TranslationMode, Converter={x:Static converts:InputTranslationModeToBoolConverter.Instance}}">
                <Grid ColumnDefinitions="*,420"
                      MinHeight="64"
                      Margin="8,0"
                      ColumnSpacing="16">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="TSF"
                                   Classes="Small" />
                        <TextBlock Text="{Binding TsfStatusText}"
                                   Classes="Muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Content="{Binding RetryTsfRegistrationText}"
                                Command="{Binding RetryTsfRegistrationCommand}" />
                        <Button Content="{Binding OpenWindowsInputSettingsText}"
                                Command="{Binding OpenWindowsInputSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='translation input mode TSF seamless normal window 翻译输入方式 无感 普通窗口'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16">
                <TextBlock Text="{x:Static lang:Resources.InputTranslationMode}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding InputTranslationModes}"
                              SelectedItem="{Binding InputConf.TranslationMode}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource InputTranslationModeToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='key send delay delay key 按键发送延迟 发送 延迟'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  IsVisible="{Binding InputConf.DeliveryMode, Converter={StaticResource DeliveryModeToBoolConverter}}">
                <TextBlock Text="{x:Static lang:Resources.KeySendDelay}"
                           Classes="Small"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <NumericUpDown Value="{Binding InputConf.KeySendDelay}"
                                       Minimum="0" Maximum="1000" Increment="10"
                                       FormatString="N0"
                                       HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Column="1"
                                   Text="ms"
                                   Classes="Muted"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                    </Grid>
                </ContentControl>
            </Grid>
            </Border>

            <Border Classes="SettingsSearchRow"
                    Classes.SearchResult="{Binding IsSearchMode}"
                    IsVisible="{Binding SearchText, Converter={x:Static converts:SettingsFieldVisibleConverter.Instance}, ConverterParameter='reverse translate language reverse language 反向翻译(输入) 反向翻译 输入 反转 翻译 语言'}">
            <Grid ColumnDefinitions="*,420"
                  MinHeight="40"
                  Margin="8,0"
                  ColumnSpacing="16"
                  >
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static lang:Resources.ReverseTranslateLanguage}"
                               Classes="Small"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Border Width="28" Height="28"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Help"
                            ToolTip.Tip="{x:Static lang:Resources.ReverseTranslateLanguageTip}">
                        <avalonia:MaterialIcon Kind="HelpCircleOutline"
                                               Width="15" Height="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedColor}" />
                    </Border>
                </StackPanel>
                <ContentControl Classes="SettingsField" Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch">
                    <ToggleSwitch IsChecked="{Binding InputConf.ReverseTranslateLanguage}"
                                  OnContent="" OffContent=""
                                  HorizontalAlignment="Left" />
                </ContentControl>
            </Grid>
            </Border>
    </StackPanel>
</UserControl>
