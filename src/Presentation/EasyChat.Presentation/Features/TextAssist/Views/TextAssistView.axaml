<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:views="using:EasyChat.Presentation.Features.TextAssist.Views"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:ec="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistView"
             x:DataType="vm:TextAssistViewModel"
             Background="{DynamicResource EcBgCanvas}">
    <Grid Classes="EcPageFrame"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <ec:EcPageHeader Title="{x:Static lang:Resources.TextAssist}"
                         Subtitle="{x:Static lang:Resources.TextAssistSubtitle}">
            <ec:EcPageHeader.Actions>
                <Panel>
                    <Button Classes="EcPrimary"
                            Command="{Binding Translation.RunCommand}"
                            IsVisible="{Binding IsTranslationMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Translate" Width="16" Height="16"
                                                   IsVisible="{Binding !Translation.IsBusy}" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="EcPrimary"
                            Command="{Binding Correction.RunCommand}"
                            IsVisible="{Binding IsCorrectionMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Spellcheck" Width="16" Height="16"
                                                   IsVisible="{Binding !Correction.IsBusy}" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Panel>
            </ec:EcPageHeader.Actions>
        </ec:EcPageHeader>

        <Border Classes="EcSegmented" HorizontalAlignment="Left" Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="EcSegment"
                             GroupName="TextAssistPageMode"
                             Content="{x:Static lang:Resources.TextAssistTranslate}"
                             IsChecked="{Binding IsTranslationMode}" />
                <RadioButton Classes="EcSegment"
                             GroupName="TextAssistPageMode"
                             Content="{x:Static lang:Resources.TextAssistCorrect}"
                             IsChecked="{Binding IsCorrectionMode}" />
            </StackPanel>
        </Border>

        <views:TextAssistTranslationView Grid.Row="2"
                                         DataContext="{Binding Translation}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         IsVisible="{Binding $parent[UserControl].((vm:TextAssistViewModel)DataContext).IsTranslationMode}" />
        <views:TextAssistCorrectionView Grid.Row="2"
                                        DataContext="{Binding Correction}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{Binding $parent[UserControl].((vm:TextAssistViewModel)DataContext).IsCorrectionMode}" />
    </Grid>
</UserControl>
