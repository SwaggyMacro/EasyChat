<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:controls="using:EasyChat.Presentation.Features.TextAssist.Controls"
             xmlns:dataConverters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:settings="clr-namespace:EasyChat.Contracts.Settings;assembly=EasyChat.Contracts"
             xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistCorrectionView"
             x:DataType="vm:TextAssistCorrectionViewModel">
    <UserControl.Styles>

        <Style Selector="Border.EditorCard">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="UserControl.Compact Border.EditorCard">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="StackPanel.EditorSections">
            <Setter Property="Spacing" Value="14" />
        </Style>
        <Style Selector="UserControl.Compact StackPanel.EditorSections">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EcTextPrimary}" />
        </Style>
        <Style Selector="UserControl.Compact TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.IssueCard">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="UserControl.Compact Border.IssueCard">
            <Setter Property="Padding" Value="8" />
        </Style>
        <!-- Floor only — parent * row grows the editor so the page is not hollow. -->
        <Style Selector="Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="UserControl.Compact Grid.OriginalEditor">
            <Setter Property="MinHeight" Value="125" />
        </Style>
        <Style Selector="TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.OriginalTextBox">
            <Setter Property="MinHeight" Value="125" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="UserControl.Compact controls|CorrectionAnnotationLayer.OriginalAnnotation">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="55" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.VariantTextBox">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Grid.EditorFooter">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorFooter">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Page already has header Run; keep footer Run only in compact float. -->
        <Style Selector="UserControl:not(.Compact) Button.EditorInlineRun">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <!--
      Match translation layout: primary editor is * (fills pane). Results/issues sit in a
      capped scroll band under it so empty page height is absorbed by the input surface,
      not left as white void under a MinHeight-only card.
    -->
    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto"
          RowSpacing="0"
          MinHeight="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Primary editor: grows with available height -->
        <Border Grid.Row="0"
                Classes="EditorCard EcSurface"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.SourceLang}" />
                <Grid Grid.Row="1" Classes="OriginalEditor" MinHeight="0">
                    <TextBox x:Name="AnnotatedTextBox"
                             Classes="OriginalTextBox"
                             Text="{Binding InputText, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             BorderThickness="0"
                             Background="Transparent"
                             PointerMoved="OnOriginalPointerMoved"
                             PointerExited="OnOriginalPointerExited" />
                    <controls:CorrectionAnnotationLayer x:Name="AnnotationLayer"
                             Classes="OriginalAnnotation"
                             IsHitTestVisible="False"
                             Text="{Binding InputText}"
                             Issues="{Binding Issues}"
                             FontSize="16"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />
                    <Border x:Name="CorrectionHint"
                            IsVisible="False"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            MaxWidth="420"
                            Padding="10,7"
                            Background="{DynamicResource EcFloatBg}"
                            BorderBrush="{DynamicResource EcFloatBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="CorrectionHintText"
                                   Foreground="{DynamicResource EcTextPrimary}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Results + issues under the expanding editor; hidden until output exists -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,0"
                      MaxHeight="280"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasCorrectionOutput}">
            <StackPanel Classes="EditorSections" Spacing="12">
                <Border Classes="EditorCard EcSurface" IsVisible="{Binding HasCorrectedResults}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.TextAssistCorrectedResult}" />
                        <ItemsControl ItemsSource="{Binding CorrectionVariants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                        <StackPanel Spacing="3">
                                            <TextBox Classes="VariantTextBox"
                                                     Text="{Binding Text}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     FontSize="18"
                                                     VerticalContentAlignment="Top"
                                                     BorderThickness="0"
                                                     Background="Transparent" />
                                            <TextBlock Text="{Binding Translation}"
                                                       Foreground="{DynamicResource EcTextPrimary}"
                                                       Opacity="0.58"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding Translation, Converter={x:Static dataConverters:StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="EcToolbarBtn"
                                                Tag="{Binding}"
                                                Click="OnCopyCorrectionClick"
                                                ToolTip.Tip="{x:Static lang:Resources.Copy}"
                                                VerticalAlignment="Top">
                                            <avalonia:MaterialIcon Kind="ContentCopy" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding HasCorrectionIssues}">
                    <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.TextAssistIssues}" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="IssueCard EcSurface" Margin="0,0,0,6" CornerRadius="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding DisplayCategory}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource EcTextPrimary}" />
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EcTextPrimary}" />
                                        <TextBlock Text="{Binding Suggestion}"
                                                   Foreground="{DynamicResource EcAccent}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="0,6">
            <Button Classes="EcGhost"
                    HorizontalAlignment="Left"
                    Command="{Binding ToggleConfigurationCommand}"
                    ToolTip.Tip="{Binding ConfigurationToggleText}"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <avalonia:MaterialIcon Kind="{Binding ConfigurationToggleIcon}" Width="16" Height="16" />
                    <TextBlock Text="{Binding ConfigurationToggleText}"
                               VerticalAlignment="Center"
                               FontSize="12.5" />
                </StackPanel>
            </Button>
        </Border>

        <Border Grid.Row="3"
                Classes="EditorCard EcSurface"
                IsVisible="{Binding IsConfigurationExpanded}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.SourceLang}"
                                   FontSize="12"
                                   Foreground="{DynamicResource EcTextSecondary}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSourceLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel Width="22" Height="16">
                                            <avalonia:MaterialIcon Kind="FlagOutline"
                                                                   Opacity="0.65"
                                                                   IsVisible="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.HasNoIcon}}" />
                                            <Image Width="22" Height="16"
                                                   IsVisible="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.HasIcon}}"
                                                   Source="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.ToIcon}}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel Width="18" Height="18">
                                            <avalonia:MaterialIcon Kind="Translate" Opacity="0.65" />
                                            <Image Width="18" Height="18"
                                                   Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{x:Static lang:Resources.Prompts}" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding PromptEntries}"
                                  SelectedValue="{Binding SelectedPromptId}"
                                  SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4"
              Classes="EditorFooter"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="10">
            <Button Command="{Binding RunCommand}" Classes="EcPrimary EditorInlineRun">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="Spellcheck" IsVisible="{Binding !IsBusy}" />
                    <suki:Loading Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{x:Static lang:Resources.TextAssistCorrect}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Command="{Binding CancelCommand}"
                    Classes="EcGhost"
                    IsVisible="{Binding IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <avalonia:MaterialIcon Kind="Stop" />
                    <TextBlock Text="{x:Static lang:Resources.Cancel}" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource EcDanger}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
