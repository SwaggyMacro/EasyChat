<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
                 x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistWindowView"
                 x:DataType="vm:TextAssistViewModel"
                 Width="860" Height="480" MinWidth="620" MinHeight="360"
                 CanResize="True"
                 WindowStartupLocation="CenterScreen"
                 WindowDecorations="None"
                 ExtendClientAreaToDecorationsHint="True"
                 TransparencyLevelHint="Transparent"
                 TransparencyBackgroundFallback="Transparent"
                 Background="Transparent"
                 Foreground="{DynamicResource EcTextPrimary}"
                 IsTitleBarVisible="False"
                 RootCornerRadius="14"
                 Topmost="True"
                 ShowInTaskbar="False"
                 CornerRadius="14"
                 Title="{Binding WindowTitle}">
    <Grid>
        <Border x:Name="MainCard"
                Classes="EcFloatShell"
                Padding="0">
            <Border Classes="EcFloatClip">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Padding="10,8"
                        Background="{DynamicResource EcBgElevated}"
                        BorderBrush="{DynamicResource EcBorder}"
                        BorderThickness="0,0,0,1"
                        PointerPressed="OnHeaderPointerPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="{Binding WindowIcon}" Width="16" Height="16" Foreground="{DynamicResource EcAccent}" />
                            <TextBlock Text="{Binding WindowTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource EcTextPrimary}" />
                        </StackPanel>
                        <!-- Mode switch: translate <-> correct without closing the float -->
                        <Border Grid.Column="1"
                                Classes="EcSegmented"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                PointerPressed="OnHeaderChromePointerPressed">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton Classes="EcSegment"
                                             GroupName="TextAssistFloatMode"
                                             Content="{x:Static lang:Resources.TextAssistTranslate}"
                                             IsChecked="{Binding IsTranslationMode}"
                                             FontSize="12"
                                             Padding="12,5" />
                                <RadioButton Classes="EcSegment"
                                             GroupName="TextAssistFloatMode"
                                             Content="{x:Static lang:Resources.TextAssistCorrect}"
                                             IsChecked="{Binding IsCorrectionMode}"
                                             FontSize="12"
                                             Padding="12,5" />
                            </StackPanel>
                        </Border>
                        <suki:Loading Grid.Column="2" Width="14" Height="14"
                                      IsVisible="{Binding IsCapturingInput}"
                                      VerticalAlignment="Center" />
                        <Button Grid.Column="3" Click="OnCloseClick" Classes="EcToolbarBtn"
                                ToolTip.Tip="{x:Static lang:Resources.Close}">
                            <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" x:Name="EditorHost" Margin="14" />
            </Grid>
            </Border>
        </Border>

        <!-- A borderless window needs explicit hit targets for native resize drags. -->
        <Border Width="6" HorizontalAlignment="Left" Background="Transparent"
                Cursor="LeftSide" Tag="West" PointerPressed="OnResizePointerPressed" />
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent"
                Cursor="RightSide" Tag="East" PointerPressed="OnResizePointerPressed" />
        <Border Height="6" VerticalAlignment="Top" Background="Transparent"
                Cursor="TopSide" Tag="North" PointerPressed="OnResizePointerPressed" />
        <Border Height="6" VerticalAlignment="Bottom" Background="Transparent"
                Cursor="BottomSide" Tag="South" PointerPressed="OnResizePointerPressed" />

        <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest"
                PointerPressed="OnResizePointerPressed" />
        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast"
                PointerPressed="OnResizePointerPressed">
            <avalonia:MaterialIcon Kind="ResizeBottomRight" Width="14" Height="14"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,2,2" Opacity="0.45" IsHitTestVisible="False" />
        </Border>
    </Grid>
</suki:SukiWindow>
