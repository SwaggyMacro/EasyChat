<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:textAssist="using:EasyChat.Presentation.Features.TextAssist"
             xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
             xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistTranslationView"
             x:Name="TranslationView"
             x:DataType="vm:TextAssistTranslationViewModel">
    <UserControl.Styles>
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource EcTextPrimary}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource EcTextPrimary}" />
        </Style>

        <Style Selector="Border.EditorCard">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="UserControl.Compact Border.EditorCard">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Grid.EditorContent">
            <Setter Property="RowSpacing" Value="8" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorContent">
            <Setter Property="RowSpacing" Value="5" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EcTextPrimary}" />
        </Style>
        <Style Selector="UserControl.Compact TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Grid.EditorPair">
            <Setter Property="MinHeight" Value="150" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorPair">
            <Setter Property="MinHeight" Value="120" />
        </Style>
        <Style Selector="TextBox.EditorTextBox">
            <Setter Property="MinHeight" Value="100" />
        </Style>
        <Style Selector="UserControl.Compact TextBox.EditorTextBox">
            <Setter Property="MinHeight" Value="80" />
        </Style>
        <Style Selector="Grid.EditorFooter">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="UserControl.Compact Grid.EditorFooter">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Page already has header Run; keep footer Run only in compact float. -->
        <Style Selector="UserControl:not(.Compact) Button.EditorInlineRun">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="0" MinHeight="0">
        <Grid Grid.Row="0" RowSpacing="0" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding ShowAnnotations, Converter={x:Static converters:BoolToGridLengthConverter.Instance}, ConverterParameter=160}" />
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Classes="EditorPair" ColumnDefinitions="*,Auto,*" ColumnSpacing="4" VerticalAlignment="Stretch">
                <Border Classes="EditorCard EcSurface">
                    <Grid Classes="EditorContent" RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.SourceLang}" />
                            <Button Grid.Column="1" Classes="EcToolbarBtn" Command="{Binding SpeakSourceCommand}" ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Source}">
                                <avalonia:MaterialIcon Kind="VolumeHigh" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSourceLanguage}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="22" Height="16">
                                    <avalonia:MaterialIcon Kind="FlagOutline" Opacity="0.65"
                                                           IsVisible="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.HasNoIcon}}" />
                                    <Image Width="22" Height="16"
                                           IsVisible="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.HasIcon}}"
                                           Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" />
                                </Panel>
                                <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="SourceTextBox" Classes="EditorTextBox" Text="{Binding InputText, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}"
                                     VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                                     />
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Classes="EcToolbarBtn" Width="36" Height="36" Padding="4"
                        VerticalAlignment="Center" Command="{Binding SwapContentCommand}"
                        ToolTip.Tip="{x:Static lang:Resources.ReverseTranslateLanguageTip}">
                    <Border Width="28" Height="28" CornerRadius="999"
                            Background="{DynamicResource EcAccentMuted}">
                        <avalonia:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource EcAccent}" />
                    </Border>
                </Button>

                <Border Grid.Column="2" Classes="EditorCard EcSurface">
                    <Grid Classes="EditorContent" RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="SectionTitle" Text="{x:Static lang:Resources.TargetLang}" />
                            <Button Grid.Column="1" Classes="EcToolbarBtn" Click="OnCopyClick" ToolTip.Tip="{x:Static lang:Resources.Copy}">
                                <avalonia:MaterialIcon Kind="ContentCopy" />
                            </Button>
                            <Button Grid.Column="2" Classes="EcToolbarBtn" Command="{Binding SpeakResultCommand}" ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Target}">
                                <avalonia:MaterialIcon Kind="VolumeHigh" />
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedTargetLanguage}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="22" Height="16">
                                    <avalonia:MaterialIcon Kind="FlagOutline" Opacity="0.65"
                                                           IsVisible="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.HasNoIcon}}" />
                                    <Image Width="22" Height="16"
                                           IsVisible="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.HasIcon}}"
                                           Source="{Binding Icon, Converter={x:Static converters:LanguageFlagConverters.ToIcon}}" />
                                </Panel>
                                <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="ResultTextBox" Classes="EditorTextBox" Text="{Binding TranslationResult}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="18"
                                     VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent"
                                     PlaceholderText="{x:Static lang:Resources.Loading}" />
                        </Grid>
                    </Grid>
                </Border>
        </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Margin="0,6,0,6"
                          Background="{DynamicResource EcBorder}"
                          Opacity="0.85" Cursor="SizeNorthSouth"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding ShowAnnotations}" />

            <Border Grid.Row="2" Classes="EditorCard EcSurface" MinHeight="80"
                            IsVisible="{Binding ShowAnnotations}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="BookOpenVariant" Width="18" Height="18"
                                               Foreground="{DynamicResource EcAccent}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistAnnotations}"
                                   Classes="SectionTitle" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Annotations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="textAssist:TextAssistAnnotationViewModel">
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="10"
                                                        Background="{DynamicResource EcBgMuted}"
                                                        BorderBrush="{DynamicResource EcBorder}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Classes="EcToolbarBtn" Padding="0"
                                                                    Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                    CommandParameter="{Binding Term}"
                                                                    ToolTip.Tip="{x:Static lang:Resources.ResultWindowMode_Dictionary}">
                                                                <TextBlock Text="{Binding Term}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource EcAccent}"
                                                                           TextDecorations="Underline" />
                                                            </Button>
                                                            <Border Padding="6,2" CornerRadius="999"
                                                                    Background="{DynamicResource EcAccentMuted}">
                                                                <TextBlock Text="{Binding DisplayCategory}" FontSize="11"
                                                                           Foreground="{DynamicResource EcTextSecondary}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource EcTextPrimary}" />
                                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource EcTextSecondary}"
                                                                   IsVisible="{Binding HasNote}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding HasRelatedTerms}">
                                                            <TextBlock Text="{x:Static lang:Resources.TextAssistRelatedTerms}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource EcTextMuted}"
                                                                       VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding RelatedTerms}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Button Classes="EcToolbarBtn" Padding="3,0"
                                                                                Command="{Binding #TranslationView.((vm:TextAssistTranslationViewModel)DataContext).LookupAnnotationCommand}"
                                                                                CommandParameter="{Binding}">
                                                                            <TextBlock Text="{Binding}"
                                                                                       Foreground="{DynamicResource EcAccent}"
                                                                                       TextDecorations="Underline" FontSize="12" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

            <!-- Always-visible config toggle (no hover-to-discover) -->
            <Border Grid.Row="1" Padding="0,6">
                <Button Classes="EcGhost"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleConfigurationCommand}"
                        ToolTip.Tip="{Binding ConfigurationToggleText}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="{Binding ConfigurationToggleIcon}" Width="16" Height="16" />
                        <TextBlock Text="{Binding ConfigurationToggleText}"
                                   VerticalAlignment="Center"
                                   FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Border>

            <Border Grid.Row="2" Classes="EditorCard EcSurface"
                            IsVisible="{Binding IsConfigurationExpanded}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.TransEngine}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:MaterialIcon Kind="{Binding Converter={x:Static converters:TranslationEngineStringToIconKindConverter.Instance}}" Width="18" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsAiProvider}">
                            <TextBlock Text="{x:Static lang:Resources.UsingAiModel}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding ModelType, Converter={x:Static converters:AiModelTypeConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Static lang:Resources.Prompts}" FontSize="12" Opacity="0.7" />
                            <ComboBox ItemsSource="{Binding PromptEntries}" SelectedValue="{Binding SelectedPromptId}" SelectedValueBinding="{Binding Id}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsMachineProvider}">
                        <TextBlock Text="{x:Static lang:Resources.MachineTranslation}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MachineProviders}" SelectedItem="{Binding SelectedMachineProvider}">
                            <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="18" Height="18"><avalonia:MaterialIcon Kind="Translate" Opacity="0.65" /><Image Width="18" Height="18" Source="{Binding Converter={x:Static converters:EngineConverters.ToIcon}}" /></Panel>
                                <TextBlock Text="{Binding}" />
                            </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                          ToolTip.Tip="{x:Static lang:Resources.TextAssistDetailedExplanationTip}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <avalonia:MaterialIcon Kind="BookEducationOutline" Width="18" Height="18" />
                            <TextBlock Text="{x:Static lang:Resources.TextAssistDetailedExplanation}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding DetailedExplanation}"
                                      IsEnabled="{Binding IsAiProvider}" OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Classes="EditorFooter" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Command="{Binding RunCommand}" Classes="EcPrimary EditorInlineRun">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:MaterialIcon Kind="Translate" IsVisible="{Binding !IsBusy}" />
                        <suki:Loading Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{x:Static lang:Resources.TextAssistTranslate}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Classes="EcGhost" IsVisible="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><avalonia:MaterialIcon Kind="Stop" /><TextBlock Text="{x:Static lang:Resources.Cancel}" /></StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource EcDanger}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
    </Grid>
</UserControl>
