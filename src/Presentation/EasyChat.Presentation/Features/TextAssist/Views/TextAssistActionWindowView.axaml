<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:converters="clr-namespace:EasyChat.Presentation.Foundation.Formatting"
                 xmlns:vm="using:EasyChat.Presentation.Features.TextAssist"
                 xmlns:sharedControls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
                 xmlns:lang="clr-namespace:EasyChat.Presentation.Lang"
                 x:Class="EasyChat.Presentation.Features.TextAssist.Views.TextAssistActionWindowView"
                 x:DataType="vm:TextAssistResultWindowViewModel"
                 Width="820" Height="520" WindowStartupLocation="CenterScreen" Title="{Binding Title}"
                 Foreground="{DynamicResource EcTextPrimary}">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="{Binding WindowIcon}" Width="22" Height="22"
                                    Foreground="{DynamicResource EcAccent}" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource EcTextPrimary}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedSourceLanguage}" IsVisible="{Binding ShowLanguageSelector}">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="7">
                    <Panel Width="22" Height="16">
                        <icons:MaterialIcon Kind="FlagOutline" Opacity="0.65"
                                            IsVisible="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.HasNoIcon}}" />
                        <Image Width="22" Height="16"
                               IsVisible="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.HasIcon}}"
                               Source="{Binding Icon, Converter={x:Static sharedControls:LanguageFlagConverters.ToIcon}}" />
                    </Panel>
                        <TextBlock Text="{Binding Converter={x:Static converters:LanguageSettingsConverters.ToDisplayName}}" VerticalAlignment="Center" />
                </StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="EcSurface" Padding="12">
                <TextBox Text="{Binding SourceText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         PlaceholderText="{x:Static lang:Resources.TextAssistInputPlaceholderText}" />
            </Border>
            <Border Grid.Column="1" Classes="EcSurface" Padding="14">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsBusy}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Result}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource EcTextPrimary}" />
                            <StackPanel Spacing="8" IsVisible="{Binding HasPolishExplanations}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <icons:MaterialIcon Kind="BookOpenVariant" Foreground="{DynamicResource EcAccent}" />
                                    <TextBlock Text="{Binding PolishExplanationTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource EcTextPrimary}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding PolishExplanations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" Margin="0,0,0,7" Classes="EcSurfaceMuted">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource EcAccent}" />
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EcTextPrimary}" />
                                                    <TextBlock Text="{Binding Revised}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource EcTextSecondary}"
                                                               IsVisible="{Binding HasRevised}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <suki:Loading IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource EcDanger}"
                   TextWrapping="Wrap" />
        <!-- Sticky action bar: Retry + Copy as primary outcomes -->
        <Border Grid.Row="3"
                Classes="EcSurfaceMuted"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="EcGhost"
                        Command="{Binding RetryCommand}"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Retry}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="EcPrimary"
                        Click="OnCopyClick"
                        IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                        <TextBlock Text="{x:Static lang:Resources.Copy}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</suki:SukiWindow>
