<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        xmlns:lang="using:EasyChat.Presentation.Lang"
        xmlns:vm="using:EasyChat.Presentation.Features.Translation"
        xmlns:controls="clr-namespace:EasyChat.Presentation.Shared.Controls;assembly=EasyChat.Presentation.Shared"
        xmlns:converts="clr-namespace:EasyChat.Presentation.Foundation.Formatting;assembly=EasyChat.Presentation"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
        x:Class="EasyChat.Presentation.Features.Translation.Views.TranslationDictionaryWindowView"
        x:DataType="vm:TranslationDictionaryWindowViewModel"
        x:Name="TranslationWindow"
        Width="450" MinWidth="150" MinHeight="250" MaxHeight="900"
        WindowDecorations="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CornerRadius="12"
        CanResize="True"
        Focusable="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height">

    <Window.Styles>
        <!-- Style for interactive word tokens -->
        <Style Selector="Button.WordToken">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,2"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            
            <!-- Keep background transparent on hover -->
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- Non-word tokens -->
            <Style Selector="^.NonWord">
                 <Setter Property="Cursor" Value="Arrow"/>
                 <Setter Property="IsEnabled" Value="False"/> 
                 <Style Selector="^ /template/ ContentPresenter">
                     <Setter Property="Background" Value="Transparent"/>
                     <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                 </Style>
            </Style>
        </Style>

        <!-- Animated Underline Base Style -->
        <Style Selector="Border.AnimatedUnderline">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Height" Value="3"/> <!-- Thicker as requested -->
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="scaleX(0)"/>
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/> <!-- Left Anchor -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CircularEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Animated Underline Trigger -->
        <!-- Important: Target the Border inside the Button when Button is hovered -->
        <Style Selector="Button.WordToken:pointerover Border.AnimatedUnderline">
            <Setter Property="RenderTransform" Value="scaleX(1)"/>
        </Style>

        <Style Selector="Button.TtsButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </Style>

        <Style Selector="StackPanel.StreamingSkeleton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
            <Style Selector="^.loading">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Height" Value="125"/>
            </Style>
        </Style>

        <Style Selector="StackPanel.StreamingSkeleton.TranslationSkeleton.loading">
            <Setter Property="Height" Value="68"/>
        </Style>

        <Style Selector="StackPanel.StreamingSkeleton.loading">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Keep Markdown readable in both light and dark themes without oversized headings. -->
        <Style Selector="md|MarkdownRenderer.DictionaryTranslationMarkdown">
            <Style Selector="^ md|MarkdownTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="WrapWithOverflow" />
            </Style>
            <Style Selector="^ Border.Heading1Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
            <Style Selector="^ Border.Heading2Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
            <Style Selector="^ Border.Heading3Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
            <Style Selector="^ Border.Heading4Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
            <Style Selector="^ Border.Heading5Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
            <Style Selector="^ Border.Heading6Block">
                <Style Selector="^ md|MarkdownTextBlock">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Style>
        </Style>
    </Window.Styles>

    <Panel Margin="5">
        <Border Padding="0"
                CornerRadius="12"
                ClipToBounds="True"
                Background="{DynamicResource DialogBackgroundColor}"
                BorderThickness="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundColor}"
                        CornerRadius="12,12,0,0" Padding="16,12"
                        IsVisible="{Binding IsWordMode}">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Dynamic Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <!-- Back Button (Word Mode) -->
                            <Button IsVisible="{Binding ShowBackButton}" 
                                    Command="{Binding SwitchToSentenceModeCommand}"
                                    Classes="TtsButton">
                                <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18"
                                                    Foreground="{DynamicResource ForegroundColor}"/>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DictionaryResult.Word, FallbackValue='Translation'}" 
                                           IsVisible="{Binding IsWordMode}"
                                           FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ForegroundColor}"/>
                                <StackPanel IsVisible="{Binding IsWordMode}" Spacing="3">
                                    <!-- Keep each pronunciation together and wrap the second one when space is tight. -->
                                    <WrapPanel IsVisible="{Binding ShowEnglishPronunciation}" Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,3">
                                            <Border Width="20" Height="11" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource GhostColor}">
                                                <Image Source="{Binding BritishFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding DictionaryResult.Phonetic}" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Classes="TtsButton" Width="24" Height="24" Margin="2,0,0,0"
                                                    Command="{Binding PlayBritishAudioCommand}"
                                                    CommandParameter="{Binding DictionaryResult.Word}"
                                                    ToolTip.Tip="British English">
                                                <Panel IsHitTestVisible="False">
                                                    <icons:MaterialIcon Kind="VolumeHigh" Width="15" Height="15" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowBritishTtsIcon}"/>
                                                    <icons:MaterialIcon Kind="Stop" Width="15" Height="15" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsBritishTtsPlaying}"/>
                                                    <shad:Loading Width="15" Height="15" IsVisible="{Binding IsBritishTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,3">
                                            <Border Width="20" Height="11" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource GhostColor}">
                                                <Image Source="{Binding AmericanFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                            <TextBlock Text="{Binding DictionaryResult.Phonetic}" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Classes="TtsButton" Width="24" Height="24" Margin="2,0,0,0"
                                                    Command="{Binding PlayAmericanAudioCommand}"
                                                    CommandParameter="{Binding DictionaryResult.Word}"
                                                    ToolTip.Tip="American English">
                                                <Panel IsHitTestVisible="False">
                                                    <icons:MaterialIcon Kind="VolumeHigh" Width="15" Height="15" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowAmericanTtsIcon}"/>
                                                    <icons:MaterialIcon Kind="Stop" Width="15" Height="15" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsAmericanTtsPlaying}"/>
                                                    <shad:Loading Width="15" Height="15" IsVisible="{Binding IsAmericanTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Grid IsVisible="{Binding ShowGenericWordAudio}" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding DictionaryResult.Phonetic}" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="TtsButton" Margin="6,0,0,0"
                                                Command="{Binding PlayTtsCommand}"
                                                CommandParameter="{Binding DictionaryResult.Word}"
                                                ToolTip.Tip="{x:Static lang:Resources.ReadAloudMode_Target}">
                                            <Panel IsHitTestVisible="False">
                                                <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowWordTtsIcon}"/>
                                                <icons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsWordTtsPlaying}"/>
                                                <shad:Loading Width="16" Height="16" IsVisible="{Binding IsWordTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                
                            </StackPanel>
                        </Grid>

                        <!-- Streaming state is intentionally non-blocking so partial results remain usable. -->
                        <shad:Loading Grid.Column="1"
                                      Width="16"
                                      Height="16"
                                      IsVisible="{Binding IsLoading}"
                                      IsHitTestVisible="False"
                                      Foreground="{DynamicResource PrimaryColor}"
                                      ToolTip.Tip="{x:Static lang:Resources.Speech_Translating}"/>
                        
                    </Grid>
                </Border>
                
                <!-- Main content fills the available window height and scrolls only when needed. -->
                <Panel Grid.Row="1">
                    <Border Background="{DynamicResource CardBackgroundColor}">
                        <ScrollViewer x:Name="ContentScrollViewer"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                        <!-- Loading State Removed from inside Panel -->

                        <!-- Dictionary View (Word Mode) -->
                        <StackPanel Margin="16,8" IsVisible="{Binding IsWordMode}" Spacing="16">

                              <!-- Keeps the dictionary window stable while the first definition streams in. -->
                              <StackPanel Classes="StreamingSkeleton"
                                          Classes.loading="{Binding ShowDictionarySkeleton}"
                                          IsVisible="{Binding ShowDictionarySkeleton}"
                                          Spacing="10">
                                  <Border Height="18" Width="150" HorizontalAlignment="Left"
                                          Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                  <Border Height="14" Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                  <Border Height="14" Width="320" HorizontalAlignment="Left"
                                          Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                  <Border Height="1" Background="{DynamicResource GhostColor}" Margin="0,6" CornerRadius="{DynamicResource LgCornerRadius}" />
                                  <Border Height="14" Width="370" HorizontalAlignment="Left"
                                          Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                  <Border Height="14" Width="280" HorizontalAlignment="Left"
                                          Background="{DynamicResource GhostColor}" CornerRadius="4" />
                              </StackPanel>
                              
                              <!-- Tips -->
                             <shad:Card HasShadow="False"
                                        Background="{DynamicResource GhostColor}"
                                        BorderBrush="{DynamicResource WarningColor}"
                                        BorderThickness="1"
                                        IsVisible="{Binding DictionaryResult.Tips, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        CornerRadius="{DynamicResource LgCornerRadius}"
                                        Padding="16">
                                 <StackPanel Spacing="4">
                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                         <icons:MaterialIcon Kind="LightbulbOutline" Width="16" Height="16"
                                                             Foreground="{DynamicResource WarningColor}"/>
                                         <TextBlock Text="{x:Static lang:Resources.Tips}" Classes="Caption" FontWeight="Bold"
                                                    Foreground="{DynamicResource WarningColor}"/>
                                     </StackPanel>
                                     <TextBlock Text="{Binding DictionaryResult.Tips}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor}"/>
                                 </StackPanel>
                             </shad:Card>

                             <!-- Forms (Morphologies) -->
                             <ItemsControl ItemsSource="{Binding DictionaryResult.Forms}" IsVisible="{Binding DictionaryResult.HasForms}">
                                 <ItemsControl.ItemsPanel>
                                     <ItemsPanelTemplate>
                                         <WrapPanel Orientation="Horizontal" />
                                     </ItemsPanelTemplate>
                                 </ItemsControl.ItemsPanel>
                                 <ItemsControl.ItemTemplate>
                                     <DataTemplate DataType="vm:DictionaryFormViewModel">
                                         <Border Background="{DynamicResource GhostColor}" CornerRadius="4" Padding="6,2" Margin="0,0,8,8">
                                             <StackPanel Orientation="Horizontal" Spacing="6">
                                                 <TextBlock Text="{Binding Label}" Classes="Caption" Foreground="{DynamicResource MutedColor}" FontStyle="Italic" VerticalAlignment="Center"/>
                                                 <TextBlock Text="{Binding Word}" Classes="Small" VerticalAlignment="Center"/>
                                                 
                                                 <!-- TTS for Form -->
                                                 <Button Classes="TtsButton" Width="24" Height="24"
                                                         Command="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).PlaySourceAudioCommand}"
                                                         CommandParameter="{Binding .}">
                                                     <Panel IsHitTestVisible="False">
                                                         <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}"
                                                                             IsVisible="{Binding ShowPlayIcon}"/>
                                                         <icons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}"
                                                                             IsVisible="{Binding IsPlaying}"/>
                                                         <shad:Loading Width="14" Height="14" IsVisible="{Binding IsLoading}"
                                                                       Foreground="{DynamicResource PrimaryColor}"/>
                                                     </Panel>
                                                 </Button>
                                             </StackPanel>
                                         </Border>
                                     </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                             </ItemsControl>

                             <ItemsControl ItemsSource="{Binding DictionaryResult.Parts}">
                                 <ItemsControl.ItemTemplate>
                                     <DataTemplate DataType="vm:DictionaryPartViewModel">
                                         <StackPanel Margin="0,0,0,12">
                                             <Border Background="{DynamicResource GhostColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                     IsVisible="{Binding PartOfSpeech, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                 <TextBlock Text="{Binding PartOfSpeech}" Classes="Small"/>
                                             </Border>
                                             <ItemsControl ItemsSource="{Binding Definitions}">
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid ColumnDefinitions="Auto, *" Margin="4,2,0,4">
                                                             <Border Width="4" Height="4" Background="{DynamicResource MutedColor}" CornerRadius="2" Margin="0,8,8,0" VerticalAlignment="Top"/>
                                                             <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                                    Foreground="{DynamicResource ForegroundColor}"/>
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </StackPanel>
                                     </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                             </ItemsControl>

                             <!-- Examples -->
                             <StackPanel IsVisible="{Binding DictionaryResult.HasExamples}">
                                 <Border Background="{DynamicResource BorderColor}" Height="1" Margin="0,0,0,12"/>
                                 <TextBlock Text="{x:Static lang:Resources.Examples}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ForegroundColor}"/>
                                 <ItemsControl ItemsSource="{Binding DictionaryResult.Examples}">
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate DataType="vm:DictionaryExampleViewModel">
                                             <StackPanel Margin="0,0,0,12">
                                                  <Grid ColumnDefinitions="*,Auto" >
                                                       <TextBlock Grid.Column="0" Text="{Binding Origin}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center"/>
                                                       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                                   IsVisible="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).ShowEnglishPronunciation}">
                                                           <Border Width="18" Height="10" CornerRadius="2" ClipToBounds="True" Background="{DynamicResource GhostColor}" VerticalAlignment="Top" Margin="6,7,0,0">
                                                               <Image Source="{Binding BritishFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                                      Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                           </Border>
                                                           <Button Classes="TtsButton" Width="24" Height="24" VerticalAlignment="Top"
                                                                   Command="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).PlayBritishAudioCommand}"
                                                                   CommandParameter="{Binding .}" ToolTip.Tip="British English">
                                                               <Panel IsHitTestVisible="False">
                                                                   <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" IsVisible="{Binding ShowBritishIcon}" />
                                                                   <icons:MaterialIcon Kind="Stop" Width="16" Height="16" IsVisible="{Binding IsBritishPlaying}" />
                                                                   <shad:Loading Width="16" Height="16" IsVisible="{Binding IsBritishLoading}" />
                                                               </Panel>
                                                           </Button>
                                                           <Border Width="18" Height="10" CornerRadius="2" ClipToBounds="True" Background="{DynamicResource GhostColor}" VerticalAlignment="Top" Margin="4,7,0,0">
                                                               <Image Source="{Binding AmericanFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                                      Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                           </Border>
                                                           <Button Classes="TtsButton" Width="24" Height="24" VerticalAlignment="Top"
                                                                   Command="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).PlayAmericanAudioCommand}"
                                                                   CommandParameter="{Binding .}" ToolTip.Tip="American English">
                                                               <Panel IsHitTestVisible="False">
                                                                   <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" IsVisible="{Binding ShowAmericanIcon}" />
                                                                   <icons:MaterialIcon Kind="Stop" Width="16" Height="16" IsVisible="{Binding IsAmericanPlaying}" />
                                                                   <shad:Loading Width="16" Height="16" IsVisible="{Binding IsAmericanLoading}" />
                                                               </Panel>
                                                           </Button>
                                                       </StackPanel>
                                                       <Button Grid.Column="1" Classes="TtsButton" Margin="6,0,0,0" VerticalAlignment="Top"
                                                               IsVisible="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).ShowEnglishPronunciation, Converter={x:Static BoolConverters.Not}}"
                                                               Command="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).PlaySourceAudioCommand}"
                                                               CommandParameter="{Binding .}">
                                                           <Panel IsHitTestVisible="False">
                                                               <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" IsVisible="{Binding ShowOriginPlayIcon}" />
                                                               <icons:MaterialIcon Kind="Stop" Width="16" Height="16" IsVisible="{Binding IsOriginPlaying}" />
                                                               <shad:Loading Width="16" Height="16" IsVisible="{Binding IsOriginLoading}" />
                                                           </Panel>
                                                       </Button>
                                                  </Grid>
                                                  <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                      <TextBlock Grid.Column="0" Text="{Binding Translation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center"/>
                                                      <Button Grid.Column="1" Classes="TtsButton" Margin="6,0,0,0" VerticalAlignment="Top"
                                                              Command="{Binding #TranslationWindow.((vm:TranslationDictionaryWindowViewModel)DataContext).PlayTargetAudioCommand}"
                                                              CommandParameter="{Binding .}">
                                                          <Panel IsHitTestVisible="False">
                                                              <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16"
                                                                                  IsVisible="{Binding ShowTranslationPlayIcon}" />
                                                              <icons:MaterialIcon Kind="Stop" Width="16" Height="16"
                                                                                  IsVisible="{Binding IsTranslationPlaying}" />
                                                              <shad:Loading Width="16" Height="16"
                                                                            IsVisible="{Binding IsTranslationLoading}" />
                                                          </Panel>
                                                      </Button>
                                                  </Grid>
                                             </StackPanel>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sentence View (Transition Mode) -->
                        <Border IsVisible="{Binding !IsWordMode}" Padding="16,12,12,12">
                            <StackPanel Spacing="16">
                                <!-- Translation Result -->
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
                                        <Border Background="Transparent"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False">
                                            <icons:MaterialIcon Kind="Translate" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                                            <TextBlock Text="{x:Static lang:Resources.SelectionTranslate_ResultLabel}" VerticalAlignment="Center" Classes="Small"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowEnglishTargetAudio}">
                                                <Border Width="17" Height="10" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding BritishFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <Button Classes="TtsButton" Width="24" Height="24"
                                                        Command="{Binding PlayBritishTargetAudioCommand}"
                                                        CommandParameter="{Binding TranslationResult}"
                                                        ToolTip.Tip="British English">
                                                    <Panel IsHitTestVisible="False">
                                                        <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowBritishTargetTtsIcon}"/>
                                                        <icons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsBritishTargetTtsPlaying}"/>
                                                        <shad:Loading Width="14" Height="14" IsVisible="{Binding IsBritishTargetTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                    </Panel>
                                                </Button>
                                                <Border Width="17" Height="10" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image Source="{Binding AmericanFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <Button Classes="TtsButton" Width="24" Height="24"
                                                        Command="{Binding PlayAmericanTargetAudioCommand}"
                                                        CommandParameter="{Binding TranslationResult}"
                                                        ToolTip.Tip="American English">
                                                    <Panel IsHitTestVisible="False">
                                                        <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowAmericanTargetTtsIcon}"/>
                                                        <icons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsAmericanTargetTtsPlaying}"/>
                                                        <shad:Loading Width="14" Height="14" IsVisible="{Binding IsAmericanTargetTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                    </Panel>
                                                </Button>
                                            </StackPanel>
                                            <Button Classes="TtsButton" VerticalAlignment="Center"
                                                    IsVisible="{Binding !ShowEnglishTargetAudio}"
                                                    Command="{Binding PlayTargetAudioCommand}"
                                                    CommandParameter="{Binding TranslationResult}">
                                                <Panel IsHitTestVisible="False">
                                                    <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowResultTtsIcon}"/>
                                                    <icons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsResultTtsPlaying}"/>
                                                    <shad:Loading Width="16" Height="16" IsVisible="{Binding IsResultTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                </Panel>
                                            </Button>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="Transparent"/>

                                        <!-- Keep streaming status in the existing result header row. -->
                                        <shad:Loading Grid.Column="3"
                                                      Width="16"
                                                      Height="16"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding IsLoading}"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource PrimaryColor}"
                                                      ToolTip.Tip="{x:Static lang:Resources.Speech_Translating}"/>
                                    </Grid>
                                    <Panel Grid.Row="1">
                                        <!-- Must hide with IsVisible — Classes.loading only toggles pulse opacity. -->
                                        <StackPanel Classes="StreamingSkeleton TranslationSkeleton"
                                                    Classes.loading="{Binding ShowTranslationSkeleton}"
                                                    IsVisible="{Binding ShowTranslationSkeleton}"
                                                    Spacing="10">
                                            <Border Height="16" Width="360" HorizontalAlignment="Left"
                                                    Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                            <Border Height="16" Width="280" HorizontalAlignment="Left"
                                                    Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                            <Border Height="16" Width="320" HorizontalAlignment="Left"
                                                    Background="{DynamicResource GhostColor}" CornerRadius="4" />
                                        </StackPanel>
                                        <md:MarkdownRenderer Classes="DictionaryTranslationMarkdown"
                                                             MarkdownBuilder="{Binding TranslationMarkdown}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Top" />
                                    </Panel>
                                </Grid>

                                <Separator />

                                <!-- Interactive Source Text -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                        <icons:MaterialIcon Kind="TextShort" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                                        <TextBlock Text="{x:Static lang:Resources.SelectionTranslate_SourceLabel}" VerticalAlignment="Center" Classes="Small"/>
                                        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowEnglishSourceAudio}">
                                            <Border Width="17" Height="10" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                <Image Source="{Binding BritishFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                            <Button Classes="TtsButton" Width="24" Height="24"
                                                    Command="{Binding PlayBritishSourceAudioCommand}"
                                                    CommandParameter="{Binding SourceText}"
                                                    ToolTip.Tip="British English">
                                                <Panel IsHitTestVisible="False">
                                                    <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowBritishSourceTtsIcon}"/>
                                                    <icons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsBritishSourceTtsPlaying}"/>
                                                    <shad:Loading Width="14" Height="14" IsVisible="{Binding IsBritishSourceTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                </Panel>
                                            </Button>
                                            <Border Width="17" Height="10" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                <Image Source="{Binding AmericanFlagIcon, Converter={x:Static converts:LanguageFlagConverters.ToIcon}}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Border>
                                            <Button Classes="TtsButton" Width="24" Height="24"
                                                    Command="{Binding PlayAmericanSourceAudioCommand}"
                                                    CommandParameter="{Binding SourceText}"
                                                    ToolTip.Tip="American English">
                                                <Panel IsHitTestVisible="False">
                                                    <icons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowAmericanSourceTtsIcon}"/>
                                                    <icons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsAmericanSourceTtsPlaying}"/>
                                                    <shad:Loading Width="14" Height="14" IsVisible="{Binding IsAmericanSourceTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                        <Button Classes="TtsButton" VerticalAlignment="Center"
                                                IsVisible="{Binding !ShowEnglishSourceAudio}"
                                                Command="{Binding PlaySourceAudioCommand}"
                                                CommandParameter="{Binding SourceText}">
                                            <Panel IsHitTestVisible="False">
                                                <icons:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ShowSourceTtsIcon}"/>
                                                <icons:MaterialIcon Kind="Stop" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding IsSourceTtsPlaying}"/>
                                                <shad:Loading Width="16" Height="16" IsVisible="{Binding IsSourceTtsLoading}" Foreground="{DynamicResource PrimaryColor}"/>
                                            </Panel>
                                        </Button>
                                    </StackPanel>

                                    <controls:VirtualizedTokenDisplay
                                        Tokens="{Binding SourceTokens}"
                                        WordClickedCommand="{Binding LookupWordCommand}"
                                        LineHeight="24"
                                        Foreground="{DynamicResource ForegroundColor}"
                                        NonWordForeground="{DynamicResource MutedColor}"
                                        FontWeight="Bold"
                                        UnderlineColor="{DynamicResource PrimaryColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>
                    </ScrollViewer>
                    </Border>
                </Panel>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                         <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                             <Border Background="{DynamicResource GhostColor}"
                                     CornerRadius="4"
                                     Padding="6,2">
                                 <TextBlock Text="{Binding SourceLanguageDisplay}" FontSize="11"
                                            Foreground="{DynamicResource MutedColor}"/>
                             </Border>
                             <icons:MaterialIcon Kind="ArrowRight" Width="14" Height="14"
                                                 Foreground="{DynamicResource MutedColor}"/>
                             <Border Background="{DynamicResource GhostColor}"
                                     CornerRadius="4"
                                     Padding="6,2">
                                 <TextBlock Text="{Binding TargetLanguageDisplay}"
                                            FontSize="11"
                                            Foreground="{DynamicResource ForegroundColor}"/>
                             </Border>
                         </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Click="OnCopyClick"
                                    Classes="Primary"
                                    ToolTip.Tip="{x:Static lang:Resources.SelectionTranslate_CopyTooltip}"
                                    Padding="6" Width="32" Height="32"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{x:Static lang:Resources.Copy}">
                                <icons:MaterialIcon Kind="ContentCopy" Width="18" Height="18" />
                            </Button>
                            <Button Click="OnCloseClick"
                                    IsVisible="{Binding ShowCloseButton}"
                                    Classes="Icon"
                                    ToolTip.Tip="{x:Static lang:Resources.Close}"
                                    Padding="6" Width="32" Height="32"
                                    AutomationProperties.Name="{x:Static lang:Resources.Close}">
                                <icons:MaterialIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Resize Grip -->
                <icons:MaterialIcon Kind="ResizeBottomRight" 
                                   Grid.Row="2"
                                   Width="20" Height="20" 
                                   Foreground="{DynamicResource MutedColor}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Cursor="BottomRightCorner"
                                   PointerPressed="OnResizePointerPressed"
                                   Margin="0,0,2,2"/>
                <Border Grid.RowSpan="3"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Panel>
</Window>
