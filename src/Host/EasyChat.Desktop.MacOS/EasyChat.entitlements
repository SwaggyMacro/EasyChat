<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The .NET runtime compiles managed code as it runs, so the hardened runtime has to allow a
       just-in-time compiler and the writable-then-executable pages it needs. Without both of these
       the process dies at start-up with "Failed to create CoreCLR". -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required by the hardened runtime before AVCaptureDevice may ask for microphone access. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
