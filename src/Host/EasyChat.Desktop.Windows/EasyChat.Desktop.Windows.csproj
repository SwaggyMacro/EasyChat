<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EasyChat</AssemblyName>
    <RootNamespace>EasyChat.Desktop.Windows</RootNamespace>
    <Version>1.0.30</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\EasyChat.Desktop\Assets\easychat-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EasyChat.AcceptanceTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyChat.Desktop\EasyChat.Desktop.csproj" />
    <ProjectReference Include="..\..\Infrastructure\EasyChat.Infrastructure.Windows\EasyChat.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\..\Presentation\EasyChat.Presentation\EasyChat.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT' and Exists('..\..\Infrastructure\EasyChat.Infrastructure.Windows\Native\ImeHook\bin\$(Configuration)\EasyChat.ImeHook.Native.dll')">
    <Content Include="..\..\Infrastructure\EasyChat.Infrastructure.Windows\Native\ImeHook\bin\$(Configuration)\EasyChat.ImeHook.Native.dll"
             Link="EasyChat.ImeHook.Native.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
